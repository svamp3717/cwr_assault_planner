; Attach the Mission Arsenal action locally after the server creates and publishes the box.
@ mpSupplyBoxReady
@ !(isNull westSupplyBox)
arsenalBox = westSupplyBox
? WW4_ArsenalBoxAction >= 0 : westSupplyBox removeAction WW4_ArsenalBoxAction
WW4_ArsenalBoxAction = westSupplyBox addAction ["Open Mission Arsenal","ww4_arsenal\open.sqs"]
exit
