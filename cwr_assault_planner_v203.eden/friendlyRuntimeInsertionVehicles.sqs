; v125: spawn only the friendly transports required by the selected insertion.
; Runs on the server after randomization/cleanup and before AI or player boarding.
friendlyRuntimeInsertionVehiclesReady = false
friendlyRuntimeInsertionVehicleRequestedTotal = 0
friendlyRuntimeInsertionVehicleCreatedTotal = 0
friendlyRuntimeInsertionVehicleCrewedTotal = 0
friendlyRuntimeInsertionVehicleCrewSeatTotal = 0
friendlyRuntimeInsertionVehicleFailedTotal = 0
? insertionFoot : goto "friendlyRuntimeFinish"
? insertionTruck : goto "spawnTruckInsertion"
? insertionAPC : goto "spawnAPCInsertion"
? insertionPara : goto "friendlyRuntimeFinish"
? insertionHeli : goto "spawnHeliInsertion"
goto "friendlyRuntimeFinish"

#spawnTruckInsertion
friendlyRuntimeInsertionVehicleRequestedTotal = friendlyRuntimeInsertionVehicleRequestedTotal + 1
friendlyRuntimeVehicleSpawnComplete = false
["WW4EXT_5TBIS", 10930, 11280, 0, 70, false] exec "friendlyRuntimeVehicleOne.sqs"
@ friendlyRuntimeVehicleSpawnComplete
truckP1 = friendlyRuntimeVehicleSpawned
? alive truckP1 : friendlyRuntimeInsertionVehicleCreatedTotal = friendlyRuntimeInsertionVehicleCreatedTotal + 1
? alive truckP1 && friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewedTotal = friendlyRuntimeInsertionVehicleCrewedTotal + 1
? friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewSeatTotal = friendlyRuntimeInsertionVehicleCrewSeatTotal + friendlyRuntimeVehicleSpawnCrewCount
publicVariable "truckP1"
friendlyRuntimeInsertionVehicleRequestedTotal = friendlyRuntimeInsertionVehicleRequestedTotal + 1
friendlyRuntimeVehicleSpawnComplete = false
["WW4EXT_5T2BIS", 10960, 11280, 0, 70, false] exec "friendlyRuntimeVehicleOne.sqs"
@ friendlyRuntimeVehicleSpawnComplete
truckP2 = friendlyRuntimeVehicleSpawned
? alive truckP2 : friendlyRuntimeInsertionVehicleCreatedTotal = friendlyRuntimeInsertionVehicleCreatedTotal + 1
? alive truckP2 && friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewedTotal = friendlyRuntimeInsertionVehicleCrewedTotal + 1
? friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewSeatTotal = friendlyRuntimeInsertionVehicleCrewSeatTotal + friendlyRuntimeVehicleSpawnCrewCount
publicVariable "truckP2"
? alliedCount < 1 : goto "truckAfterA1"
friendlyRuntimeInsertionVehicleRequestedTotal = friendlyRuntimeInsertionVehicleRequestedTotal + 1
friendlyRuntimeVehicleSpawnComplete = false
["WW4EXT_5TBIS", 11030, 11285, 0, 70, false] exec "friendlyRuntimeVehicleOne.sqs"
@ friendlyRuntimeVehicleSpawnComplete
a1truck = friendlyRuntimeVehicleSpawned
? alive a1truck : friendlyRuntimeInsertionVehicleCreatedTotal = friendlyRuntimeInsertionVehicleCreatedTotal + 1
? alive a1truck && friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewedTotal = friendlyRuntimeInsertionVehicleCrewedTotal + 1
? friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewSeatTotal = friendlyRuntimeInsertionVehicleCrewSeatTotal + friendlyRuntimeVehicleSpawnCrewCount
publicVariable "a1truck"
#truckAfterA1
? alliedCount < 2 : goto "truckAfterA2"
friendlyRuntimeInsertionVehicleRequestedTotal = friendlyRuntimeInsertionVehicleRequestedTotal + 1
friendlyRuntimeVehicleSpawnComplete = false
["WW4EXT_5T2BIS", 11030, 11325, 0, 70, false] exec "friendlyRuntimeVehicleOne.sqs"
@ friendlyRuntimeVehicleSpawnComplete
a2truck = friendlyRuntimeVehicleSpawned
? alive a2truck : friendlyRuntimeInsertionVehicleCreatedTotal = friendlyRuntimeInsertionVehicleCreatedTotal + 1
? alive a2truck && friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewedTotal = friendlyRuntimeInsertionVehicleCrewedTotal + 1
? friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewSeatTotal = friendlyRuntimeInsertionVehicleCrewSeatTotal + friendlyRuntimeVehicleSpawnCrewCount
publicVariable "a2truck"
#truckAfterA2
? alliedCount < 3 : goto "truckAfterA3"
friendlyRuntimeInsertionVehicleRequestedTotal = friendlyRuntimeInsertionVehicleRequestedTotal + 1
friendlyRuntimeVehicleSpawnComplete = false
["WW4EXT_5TBIS", 11030, 11365, 0, 70, false] exec "friendlyRuntimeVehicleOne.sqs"
@ friendlyRuntimeVehicleSpawnComplete
a3truck = friendlyRuntimeVehicleSpawned
? alive a3truck : friendlyRuntimeInsertionVehicleCreatedTotal = friendlyRuntimeInsertionVehicleCreatedTotal + 1
? alive a3truck && friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewedTotal = friendlyRuntimeInsertionVehicleCrewedTotal + 1
? friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewSeatTotal = friendlyRuntimeInsertionVehicleCrewSeatTotal + friendlyRuntimeVehicleSpawnCrewCount
publicVariable "a3truck"
#truckAfterA3
? alliedCount < 4 : goto "truckAfterA4"
friendlyRuntimeInsertionVehicleRequestedTotal = friendlyRuntimeInsertionVehicleRequestedTotal + 1
friendlyRuntimeVehicleSpawnComplete = false
["WW4EXT_5T2BIS", 11030, 11405, 0, 70, false] exec "friendlyRuntimeVehicleOne.sqs"
@ friendlyRuntimeVehicleSpawnComplete
a4truck = friendlyRuntimeVehicleSpawned
? alive a4truck : friendlyRuntimeInsertionVehicleCreatedTotal = friendlyRuntimeInsertionVehicleCreatedTotal + 1
? alive a4truck && friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewedTotal = friendlyRuntimeInsertionVehicleCrewedTotal + 1
? friendlyRuntimeVehicleSpawnCrewCount > 0 : friendlyRuntimeInsertionVehicleCrewSeatTotal = friendlyRuntimeInsertionVehicleCrewSeatTotal + friendlyRuntimeVehicleSpawnCrewCount
