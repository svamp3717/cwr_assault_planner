; v133 CWA-safe objective defender counter. Counts only scripted objective infantry.
; The bunker and building systems reuse these same soldiers, so they remain part of the threshold.
reinforcementDefenderCountReady = false
_slot = _this select 0
reinforcementDefendersAlive = 0
reinforcementDefendersTotal = 8
? enemyInfantryLevel == 2 : reinforcementDefendersTotal = 16
? enemyInfantryLevel == 3 : reinforcementDefendersTotal = 24
reinforcementDefendersMaxAlive = 2
? enemyInfantryLevel == 2 : reinforcementDefendersMaxAlive = 4
? enemyInfantryLevel == 3 : reinforcementDefendersMaxAlive = 6
? _slot == 1 : goto "slot1"
? _slot == 2 : goto "slot2"
? _slot == 3 : goto "slot3"
? _slot == 4 : goto "slot4"
? _slot == 5 : goto "slot5"
goto "done"
#slot1
? enemyEast : goto "slot1East"
goto "slot1Resistance"
#slot1East
? alive w4s1E1 : reinforcementDefendersAlive = reinforcementDefendersAlive + 1
