; Fill a WEST ammunition-support asset with the mission's useful WW4 infantry stock.
; Deliberately restricted to dedicated reammo trucks and real ammunition crates.
; Ordinary cars, Jeeps, HMMWVs, APCs and transport trucks exit without modification.
_box = _this select 0
? isNull _box : exit
_class = typeOf _box
_allowed = false
? _class == assetClassWestAmmoTruck : _allowed = true
? _class == assetClassTruck5tReammo : _allowed = true
? _class == assetClassUralReammo : _allowed = true
? _class == assetClassTruckV3SGReammo : _allowed = true
? _class == assetClassWestAmmoBox : _allowed = true
? _class == assetClassAmmoBoxAddW : _allowed = true
? _class == assetClassHeavyReammoBoxWest : _allowed = true
? _class == assetClassAmmoBoxOUTW : _allowed = true
? _class == assetClassAmmoBoxOUTWW : _allowed = true
? !(_allowed) : exit
clearWeaponCargo _box
clearMagazineCargo _box
_box addMagazineCargo [assetClassWestRifleMagazine,48]
_box addMagazineCargo [assetClassWestGrenadeLauncherMagazine,18]
_box addMagazineCargo [assetClassWestLightMachinegunMagazine,10]
_box addMagazineCargo [assetClassWestMachinegunMagazine,6]
_box addMagazineCargo [assetClassWestSemiAutoSniperMagazine,8]
_box addMagazineCargo [assetClassWestBoltActionSniperMagazine,8]
_box addMagazineCargo [assetClassWestLightAT,8]
_box addMagazineCargo [assetClassWestHeavyAT,4]
; Vanilla weapons and magazines are supplied through the Mission Arsenal GUI only.
_box addMagazineCargo [assetClassHandGrenade,24]
_box addMagazineCargo [assetClassSmokeShell,12]
_box addMagazineCargo [assetClassSmokeShellGreen,6]
_box addMagazineCargo [assetClassPipeBomb,6]
_box addMagazineCargo [assetClassTimeBomb,6]
_box addMagazineCargo [assetClassMine,6]
_box addMagazineCargo [assetClassMineE,6]
? debugMode : debugLog format ["ERA DEBUG AMMO SOURCE: loaded restricted support asset class %1", _class]
exit
