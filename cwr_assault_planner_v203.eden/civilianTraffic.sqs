; v135 civilian vehicle controller.
; Active objectives keep the original three persistent parked vehicles per town.
; Two nearest non-objective towns per active objective are guaranteed; others roll 25 percent.
civilianTrafficReady = false
civCarCount = 0
? townCount < 1 : goto "carAfter1"
s1Car1 = assetClassSkodaBlueCiv createVehicle ([primaryX,primaryY,55,42,0,5] call worldOffsetPosition)
s1Car1 setDir 70
s1Car1 setFuel 0.6
s1Car2 = assetClassTrabant createVehicle ([primaryX,primaryY,-62,36,0,5] call worldOffsetPosition)
s1Car2 setDir 145
s1Car2 setFuel 0.6
s1Car3 = assetClassPV3SCiv createVehicle ([primaryX,primaryY,30,-68,0,5] call worldOffsetPosition)
s1Car3 setDir 250
s1Car3 setFuel 0.6
civCarCount = civCarCount + 3
#carAfter1
? townCount < 2 : goto "carAfter2"
s2Car1 = assetClassSkodaBlueCiv createVehicle ([secondaryX,secondaryY,55,42,0,5] call worldOffsetPosition)
s2Car1 setDir 70
s2Car1 setFuel 0.6
s2Car2 = assetClassTrabant createVehicle ([secondaryX,secondaryY,-62,36,0,5] call worldOffsetPosition)
s2Car2 setDir 145
s2Car2 setFuel 0.6
s2Car3 = assetClassPV3SCiv createVehicle ([secondaryX,secondaryY,30,-68,0,5] call worldOffsetPosition)
s2Car3 setDir 250
s2Car3 setFuel 0.6
civCarCount = civCarCount + 3
#carAfter2
? townCount < 3 : goto "carAfter3"
s3Car1 = assetClassSkodaBlueCiv createVehicle ([thirdX,thirdY,55,42,0,5] call worldOffsetPosition)
s3Car1 setDir 70
s3Car1 setFuel 0.6
s3Car2 = assetClassTrabant createVehicle ([thirdX,thirdY,-62,36,0,5] call worldOffsetPosition)
s3Car2 setDir 145
s3Car2 setFuel 0.6
s3Car3 = assetClassPV3SCiv createVehicle ([thirdX,thirdY,30,-68,0,5] call worldOffsetPosition)
s3Car3 setDir 250
s3Car3 setFuel 0.6
civCarCount = civCarCount + 3
#carAfter3
? townCount < 4 : goto "carAfter4"
s4Car1 = assetClassSkodaBlueCiv createVehicle ([fourthX,fourthY,55,42,0,5] call worldOffsetPosition)
s4Car1 setDir 70
s4Car1 setFuel 0.6
s4Car2 = assetClassTrabant createVehicle ([fourthX,fourthY,-62,36,0,5] call worldOffsetPosition)
s4Car2 setDir 145
s4Car2 setFuel 0.6
s4Car3 = assetClassPV3SCiv createVehicle ([fourthX,fourthY,30,-68,0,5] call worldOffsetPosition)
s4Car3 setDir 250
s4Car3 setFuel 0.6
civCarCount = civCarCount + 3
#carAfter4
? townCount < 5 : goto "carAfter5"
s5Car1 = assetClassSkodaBlueCiv createVehicle ([fifthX,fifthY,55,42,0,5] call worldOffsetPosition)
s5Car1 setDir 70
s5Car1 setFuel 0.6
s5Car2 = assetClassTrabant createVehicle ([fifthX,fifthY,-62,36,0,5] call worldOffsetPosition)
s5Car2 setDir 145
s5Car2 setFuel 0.6
s5Car3 = assetClassPV3SCiv createVehicle ([fifthX,fifthY,30,-68,0,5] call worldOffsetPosition)
s5Car3 setDir 250
s5Car3 setFuel 0.6
civCarCount = civCarCount + 3
#carAfter5

civilianNonObjectiveCarsReady = false
[] exec "civilianNonObjectiveCars.sqs"
@ civilianNonObjectiveCarsReady
? debugMode : debugLog format ["ERA DEBUG CIVCARS: objective parked=%1 imported25pct profiles=%2 legacyUnnamed25pct profiles=%3 total profiles=%4", civCarCount, civilianNamedCarProfileCount, civilianUnnamedCarProfileCount, civilianNonObjectiveCarProfileCount]
civilianTrafficReady = true
exit
