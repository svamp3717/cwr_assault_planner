; v87: move only the selected friendly armored support elements.
? friendlyArmorLevel >= 1 && alive supportM113 : driver supportM113 doMove [fourthX, fourthY, 0]
? friendlyArmorLevel >= 2 && alive supportTank : driver supportTank doMove [fourthX, fourthY, 0]
? friendlyArmorLevel >= 3 && alive supportAA : driver supportAA doMove [fourthX + 120, fourthY - 120, 0]
? friendlyArmorLevel >= 3 && alive supportJeep : driver supportJeep doMove [fourthX - 180, fourthY + 80, 0]
? friendlyArmorLevel >= 3 && alive supportHMMWV : driver supportHMMWV doMove [fourthX - 210, fourthY + 100, 0]
exit
