; [unit, x, y, altitude, direction] - CWA/OFP direct parachute insertion.
_unit = _this select 0
_x = _this select 1
_y = _this select 2
_z = _this select 3
_dir = _this select 4
? isNull _unit : exit
? !(alive _unit) : exit
? !(local _unit) : exit
unassignVehicle _unit
_chute = "ParachuteWest" createVehicle [_x, _y, 0]
_chute setDir _dir
_chute setPos [_x, _y, _z]
_chute setVelocity [5,4,-2]
_unit moveInDriver _chute
? debugMode && debugConsole && _unit == player : player globalChat format ["ERA DEBUG PARADROP: %1 placed in direct parachute at %2/%3/%4", name _unit, _x, _y, _z]
exit
