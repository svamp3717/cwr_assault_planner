; v121: CWA-safe runtime enemy vehicle pool selection. Uses modulo truncation because floor is not available in CWA/OFP.
enemyRuntimeVehiclesReady = false
enemyRuntimeVehicleRequestedTotal = 0
enemyRuntimeVehicleCreatedTotal = 0
enemyRuntimeVehicleCrewedTotal = 0
enemyRuntimeVehicleCrewSeatTotal = 0
@ enemyGroundVehiclePoolsReady
? !(enemyGroundVehicles) : goto "runtimeVehicleFinish"
? enemyVehicleLevel <= 0 : goto "runtimeVehicleFinish"
? enemyEast : goto "spawnRuntimeEast"
goto "spawnRuntimeResistance"
#spawnRuntimeEast
? townCount < 1 : goto "spawnRuntimeEastAfter1"
? enemyVehicleLevel < 1 : goto "spawnRuntimeEastAfter1"
enemyRuntimeVehicleRequestedTotal = enemyRuntimeVehicleRequestedTotal + 1
runtimeVehicleSpawnComplete = false
_runtimeVehicleRandom = random (count enemyEastAPCVehiclePool)
_runtimeVehicleIndex = _runtimeVehicleRandom - (_runtimeVehicleRandom % 1)
_runtimeVehicleClass = enemyEastAPCVehiclePool select _runtimeVehicleIndex
[_runtimeVehicleClass, primaryX + 135, primaryY + -95, 315, 0] exec "enemyRuntimeVehicleOne.sqs"
@ runtimeVehicleSpawnComplete
s1Eveh1 = runtimeVehicleSpawned
? alive s1Eveh1 : enemyRuntimeVehicleCreatedTotal = enemyRuntimeVehicleCreatedTotal + 1
? alive s1Eveh1 && runtimeVehicleSpawnCrewCount > 0 : enemyRuntimeVehicleCrewedTotal = enemyRuntimeVehicleCrewedTotal + 1
? runtimeVehicleSpawnCrewCount > 0 : enemyRuntimeVehicleCrewSeatTotal = enemyRuntimeVehicleCrewSeatTotal + runtimeVehicleSpawnCrewCount
publicVariable "s1Eveh1"
? enemyVehicleLevel < 2 : goto "spawnRuntimeEastAfter1"
enemyRuntimeVehicleRequestedTotal = enemyRuntimeVehicleRequestedTotal + 1
runtimeVehicleSpawnComplete = false
_runtimeVehicleRandom = random (count enemyEastLightVehiclePool)
