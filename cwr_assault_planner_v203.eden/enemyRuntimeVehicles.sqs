? alive s5Rveh5 && runtimeVehicleSpawnCrewCount > 0 : enemyRuntimeVehicleCrewedTotal = enemyRuntimeVehicleCrewedTotal + 1
? runtimeVehicleSpawnCrewCount > 0 : enemyRuntimeVehicleCrewSeatTotal = enemyRuntimeVehicleCrewSeatTotal + runtimeVehicleSpawnCrewCount
publicVariable "s5Rveh5"
#spawnRuntimeResistanceAfter5
goto "runtimeVehicleFinish"
#runtimeVehicleFinish
enemyRuntimeVehicleFailedTotal = enemyRuntimeVehicleRequestedTotal - enemyRuntimeVehicleCreatedTotal
enemyRuntimeVehicleSummary = format ["ERA RUNTIME ENEMY VEHICLES: requested=%1 created=%2 crewed=%3 crewSeats=%4 failed=%5", enemyRuntimeVehicleRequestedTotal, enemyRuntimeVehicleCreatedTotal, enemyRuntimeVehicleCrewedTotal, enemyRuntimeVehicleCrewSeatTotal, enemyRuntimeVehicleFailedTotal]
publicVariable "enemyRuntimeVehicleRequestedTotal"
publicVariable "enemyRuntimeVehicleCreatedTotal"
publicVariable "enemyRuntimeVehicleCrewedTotal"
publicVariable "enemyRuntimeVehicleCrewSeatTotal"
publicVariable "enemyRuntimeVehicleFailedTotal"
publicVariable "enemyRuntimeVehicleSummary"
enemyRuntimeVehiclesReady = true
publicVariable "enemyRuntimeVehiclesReady"
exit
