; CWA-compatible post-setup briefing update. briefing.html text is static, so selected sections are revealed with objStatus.
briefingResetComplete = false
[] exec "briefingReset.sqs"
@ briefingResetComplete
"1" objStatus "ACTIVE"
? townCount >= 2 : "2" objStatus "ACTIVE"
? townCount >= 3 : "3" objStatus "ACTIVE"
? townCount >= 4 : "4" objStatus "ACTIVE"
? townCount >= 5 : "5" objStatus "ACTIVE"
? enemyEast : "INFO_EAST" objStatus "ACTIVE"
? enemyResistance : "INFO_RESISTANCE" objStatus "ACTIVE"
? enemyInfantryLevel == 1 : "INFO_INF_SMALL" objStatus "ACTIVE"
? enemyInfantryLevel == 2 : "INFO_INF_MEDIUM" objStatus "ACTIVE"
? enemyInfantryLevel == 3 : "INFO_INF_LARGE" objStatus "ACTIVE"
? enemyVehicleLevel == 1 : "INFO_VEH_SMALL" objStatus "ACTIVE"
? enemyVehicleLevel == 2 : "INFO_VEH_MEDIUM" objStatus "ACTIVE"
? enemyVehicleLevel == 3 : "INFO_VEH_LARGE" objStatus "ACTIVE"
? bunkerLevel > 0 : "INFO_BUNKERS_PRESENT" objStatus "ACTIVE"
? bunkerLevel < 1 : "INFO_BUNKERS_NONE" objStatus "ACTIVE"
? insertionFoot : "INFO_INSERT_FOOT" objStatus "ACTIVE"
? insertionTruck : "INFO_INSERT_TRUCK" objStatus "ACTIVE"
? insertionAPC : "INFO_INSERT_APC" objStatus "ACTIVE"
? insertionPara : "INFO_INSERT_PARA" objStatus "ACTIVE"
? insertionHeli : "INFO_INSERT_HELI" objStatus "ACTIVE"
? alliedCount == 1 : "INFO_ALLIES_1" objStatus "ACTIVE"
? alliedCount == 2 : "INFO_ALLIES_2" objStatus "ACTIVE"
? alliedCount == 3 : "INFO_ALLIES_3" objStatus "ACTIVE"
? alliedCount == 4 : "INFO_ALLIES_4" objStatus "ACTIVE"
? friendlyArmorLevel == 1 : "INFO_ARMOR_1" objStatus "ACTIVE"
? friendlyArmorLevel == 2 : "INFO_ARMOR_2" objStatus "ACTIVE"
? friendlyArmorLevel == 3 : "INFO_ARMOR_3" objStatus "ACTIVE"
? supportAir : "INFO_AIR" objStatus "ACTIVE"
? civilianCharacters || objectiveType1 == 7 || objectiveType2 == 7 || objectiveType3 == 7 || objectiveType4 == 7 || objectiveType5 == 7 : "INFO_CIVILIANS" objStatus "ACTIVE"
? timeOfDayLabel == "dawn" : "INFO_TIME_DAWN" objStatus "ACTIVE"
? timeOfDayLabel == "day" : "INFO_TIME_DAY" objStatus "ACTIVE"
? timeOfDayLabel == "dusk" : "INFO_TIME_DUSK" objStatus "ACTIVE"
? timeOfDayLabel == "night" : "INFO_TIME_NIGHT" objStatus "ACTIVE"
? enemyAirSupport : "INFO_RESERVE_ATTACK" objStatus "ACTIVE"
? enemyAirReinforcement : "INFO_RESERVE_AIR" objStatus "ACTIVE"
? enemyReinforcements : "INFO_RESERVE_GROUND" objStatus "ACTIVE"
"NOTE_ARSENAL" objStatus "ACTIVE"
"NOTE_EXTRACTION" objStatus "ACTIVE"
exit
