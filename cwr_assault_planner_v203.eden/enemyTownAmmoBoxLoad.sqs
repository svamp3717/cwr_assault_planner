; v144: load one server-local town ammunition box with side-appropriate WW4 weapons and magazines.
_box = _this select 0
? isNull _box : exit
clearWeaponCargo _box
clearMagazineCargo _box
? enemyEast : goto "eastCargo"
goto "resCargo"

#eastCargo
_box addWeaponCargo [assetClassEastRifle,4]
_box addWeaponCargo [assetClassEastGrenadierRifle,1]
_box addWeaponCargo [assetClassEastMachinegun,1]
_box addWeaponCargo [assetClassEastLightMachinegun,1]
_box addWeaponCargo [assetClassEastSniperRifle,1]
_box addWeaponCargo [assetClassEastAT,2]
_box addMagazineCargo [assetClassEastRifleMagazine,32]
_box addMagazineCargo [assetClassEastGrenadeLauncherMagazine,8]
_box addMagazineCargo [assetClassEastMachinegunMagazine,5]
_box addMagazineCargo [assetClassEastLightMachinegunMagazine,8]
_box addMagazineCargo [assetClassEastSniperMagazine,10]
_box addMagazineCargo [assetClassEastAT,6]
_box addMagazineCargo [assetClassHandGrenade,12]
_box addMagazineCargo [assetClassSmokeShell,6]
goto "done"

#resCargo
_box addWeaponCargo [assetClassResistanceRifle,4]
_box addWeaponCargo [assetClassResistanceGrenadierRifle,1]
_box addWeaponCargo [assetClassResistanceMachinegun,1]
_box addWeaponCargo [assetClassResistanceBattleRifle,2]
_box addWeaponCargo [assetClassEastSniperRifle,1]
_box addWeaponCargo [assetClassEastAT,2]
_box addMagazineCargo [assetClassResistanceRifleMagazine,32]
_box addMagazineCargo [assetClassEastGrenadeLauncherMagazine,8]
_box addMagazineCargo [assetClassResistanceMachinegunMagazine,8]
_box addMagazineCargo [assetClassResistanceBattleRifleMagazine,16]
_box addMagazineCargo [assetClassEastSniperMagazine,10]
_box addMagazineCargo [assetClassEastAT,6]
_box addMagazineCargo [assetClassHandGrenade,12]
_box addMagazineCargo [assetClassSmokeShell,6]

#done
exit
