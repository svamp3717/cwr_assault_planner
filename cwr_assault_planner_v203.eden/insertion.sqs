#mixedAfterA4
driver apcP1 doMove [lzX, lzY, 0]
driver apcP2 doMove [lzX + 28, lzY + 8, 0]
driver supportM113 doMove [lzX + 55, lzY + 16, 0]
? alliedCount < 1 : goto "mixedMoveDone"
driver a1apc doMove [lzX - 35, lzY + 20, 0]
? alliedCount < 2 : goto "mixedMoveDone"
[a2truck, truckStageDir, lzX - 55, lzY + 35] exec "friendlyTruckRoadMove.sqs"
? alliedCount < 3 : goto "mixedMoveDone"
driver a3apc doMove [lzX - 75, lzY + 50, 0]
? alliedCount < 4 : goto "mixedMoveDone"
[a4truck, truckStageDir, lzX - 95, lzY + 65] exec "friendlyTruckRoadMove.sqs"
#mixedMoveDone
leadTransport = apcP1
goto "waitArrival"
#loadHeli
? heliSplit : goto "loadHeliSplit"
; v51 CH-47 mode: full player squad rides in the CH-47. UH-60 remains empty escort.
heliTransportTwoActive = false
playerHeli1 = heliP1
playerHeli2 = heliP1
heliP1 flyInHeight 130
heliP2 flyInHeight 130
player assignAsCargo playerHeli1
player moveInCargo playerHeli1
? playerAICount >= 1 : red2 assignAsCargo playerHeli1
? playerAICount >= 1 : red2 moveInCargo playerHeli1
? playerAICount >= 2 : red3 assignAsCargo playerHeli1
? playerAICount >= 2 : red3 moveInCargo playerHeli1
