a1mg moveInCargo a1apc
a1at assignAsCargo a1apc
a1at moveInCargo a1apc
a1r7 assignAsCargo a1apc
a1r7 moveInCargo a1apc
a1r8 assignAsCargo a1apc
a1r8 moveInCargo a1apc
#mixedAfterA1
? alliedCount < 2 : goto "mixedAfterA2"
a2truck setFuel 1
a2ldr assignAsCargo a2truck
a2ldr moveInCargo a2truck
a2r2 assignAsCargo a2truck
a2r2 moveInCargo a2truck
a2gren assignAsCargo a2truck
a2gren moveInCargo a2truck
a2med assignAsCargo a2truck
a2med moveInCargo a2truck
