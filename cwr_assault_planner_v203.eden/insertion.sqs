a4r8 assignAsCargo a4apc
a4r8 moveInCargo a4apc
#apcAfterA4
apcP1 setFuel 1
apcP2 setFuel 1
supportM113 setFuel 1
driver apcP1 doMove [lzX, lzY, 0]
driver apcP2 doMove [lzX + 20, lzY + 5, 0]
driver supportM113 doMove [lzX + 45, lzY + 12, 0]
? alliedCount < 1 : goto "apcMoveDone"
driver a1apc doMove [lzX - 35, lzY + 20, 0]
? alliedCount < 2 : goto "apcMoveDone"
driver a2apc doMove [lzX - 55, lzY + 35, 0]
? alliedCount < 3 : goto "apcMoveDone"
driver a3apc doMove [lzX - 75, lzY + 50, 0]
? alliedCount < 4 : goto "apcMoveDone"
driver a4apc doMove [lzX - 95, lzY + 65, 0]
#apcMoveDone
leadTransport = apcP1
goto "waitArrival"
#loadMixed
; v50 mixed option: player squad rides in two M113 cargo carriers. The M2A2 is kept as an escort, not cargo.
apcP1 setFuel 1
apcP2 setFuel 1
supportM113 setFuel 1
player assignAsCargo apcP1
player moveInCargo apcP1
? playerAICount >= 1 : red2 assignAsCargo apcP1
? playerAICount >= 1 : red2 moveInCargo apcP1
? playerAICount >= 2 : red3 assignAsCargo apcP1
? playerAICount >= 2 : red3 moveInCargo apcP1
? playerAICount >= 3 : medic1 assignAsCargo apcP1
? playerAICount >= 3 : medic1 moveInCargo apcP1
? playerAICount >= 4 : medic2 assignAsCargo apcP1
? playerAICount >= 4 : medic2 moveInCargo apcP1
? playerAICount >= 5 : red6 assignAsCargo apcP1
? playerAICount >= 5 : red6 moveInCargo apcP1
? playerAICount >= 6 : red7 assignAsCargo apcP2
? playerAICount >= 6 : red7 moveInCargo apcP2
? playerAICount >= 7 : red8 assignAsCargo apcP2
? playerAICount >= 7 : red8 moveInCargo apcP2
? playerAICount >= 8 : red9 assignAsCargo apcP2
? playerAICount >= 8 : red9 moveInCargo apcP2
? playerAICount >= 9 : red10 assignAsCargo apcP2
? playerAICount >= 9 : red10 moveInCargo apcP2
? playerAICount >= 10 : red11 assignAsCargo apcP2
? playerAICount >= 10 : red11 moveInCargo apcP2
? playerAICount >= 11 : red12 assignAsCargo apcP2
? playerAICount >= 11 : red12 moveInCargo apcP2
? alliedCount < 1 : goto "mixedAfterA1"
