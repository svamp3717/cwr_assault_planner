; v129: cargo is aboard on the ground. Landing insertion uses rotor flight; paradrop uses a high, fast, straight pass.
~8
? insertionPara : goto "launchAircraftStyleParadrop"
? !(heliSplit) : [heliP1, _airX, _airY, lzX, lzY, 130] exec "friendlyAirborneTransportStart.sqs"
? !(heliSplit) : [heliP2, _airX + 60, _airY + 20, lzX + 70, lzY + 20, 130] exec "friendlyAirborneTransportStart.sqs"
? heliSplit : [heliU1, _airX, _airY, lzX, lzY, 130] exec "friendlyAirborneTransportStart.sqs"
? heliSplit : [heliU2, _airX + 60, _airY + 20, lzX + 70, lzY + 20, 130] exec "friendlyAirborneTransportStart.sqs"
? alliedCount >= 1 : [a1heli, _airX - 70, _airY + 35, lzX - 70, lzY + 40, 130] exec "friendlyAirborneTransportStart.sqs"
? alliedCount >= 2 : [a2heli, _airX - 100, _airY + 55, lzX - 110, lzY + 65, 130] exec "friendlyAirborneTransportStart.sqs"
? alliedCount >= 3 : [a3heli, _airX - 130, _airY + 75, lzX + 110, lzY + 65, 130] exec "friendlyAirborneTransportStart.sqs"
? alliedCount >= 4 : [a4heli, _airX - 160, _airY + 95, lzX + 170, lzY + 95, 130] exec "friendlyAirborneTransportStart.sqs"
goto "afterAirborneLaunch"
#launchAircraftStyleParadrop
[playerHeli1, _airX, _airY, lzX, lzY, 220] exec "friendlyParadropTransportStart.sqs"
? !(heliTransportTwoActive) : [heliP2, _airX + 90, _airY - 30, lzX + 100, lzY - 25, 220] exec "friendlyParadropTransportStart.sqs"
? alliedCount >= 1 : [a1heli, _airX - 100, _airY + 40, lzX - 100, lzY + 40, 220] exec "friendlyParadropTransportStart.sqs"
? alliedCount >= 2 : [a2heli, _airX - 160, _airY + 80, lzX - 160, lzY + 80, 220] exec "friendlyParadropTransportStart.sqs"
? alliedCount >= 3 : [a3heli, _airX + 120, _airY - 60, lzX + 120, lzY - 60, 220] exec "friendlyParadropTransportStart.sqs"
? alliedCount >= 4 : [a4heli, _airX + 180, _airY - 100, lzX + 180, lzY - 100, 220] exec "friendlyParadropTransportStart.sqs"
#afterAirborneLaunch
~2
? insertionPara : goto "afterAirborneMoveOrders"
driver playerHeli1 doMove [lzX, lzY, 0]
? heliTransportTwoActive : driver playerHeli2 doMove [lzX + 70, lzY + 20, 0]
? !(heliTransportTwoActive) : driver heliP2 doMove [lzX + 70, lzY + 20, 0]
? alliedCount < 1 : goto "heliMoveDone"
a1heli flyInHeight 130
driver a1heli doMove [lzX - 70, lzY + 40, 0]
? alliedCount < 2 : goto "heliMoveDone"
a2heli flyInHeight 130
driver a2heli doMove [lzX - 110, lzY + 65, 0]
? alliedCount < 3 : goto "heliMoveDone"
a3heli flyInHeight 130
driver a3heli doMove [lzX + 110, lzY + 65, 0]
? alliedCount < 4 : goto "heliMoveDone"
a4heli flyInHeight 130
driver a4heli doMove [lzX + 170, lzY + 95, 0]
#heliMoveDone
#afterAirborneMoveOrders
leadTransport = playerHeli1
goto "waitArrival"
#waitArrival
~2
"lz_marker" setMarkerText format ["Insertion underway: %1", insertionLabel]
_wait = 0
#arrivalLoop
~2
_wait = _wait + 1
_curX = getPos leadTransport select 0
_curY = getPos leadTransport select 1
? _curX < lzX - 90 : goto "arrivalNotYet"
? _curX > lzX + 90 : goto "arrivalNotYet"
? _curY < lzY - 90 : goto "arrivalNotYet"
? _curY > lzY + 90 : goto "arrivalNotYet"
goto "arrivalReached"
#arrivalNotYet
? _wait > 45 : goto "arrivalReached"
goto "arrivalLoop"
#arrivalReached
? insertionPara : goto "heliParadrop"
? insertionHeli : goto "heliLanding"
goto "dismount"
#heliModeRoll
_heliMode = random 2
? _heliMode < 1 : goto "heliParadrop"
goto "heliLanding"
#heliLanding
? debugMode : debugLog "ERA DEBUG INSERTION: helicopter landing branch selected"
? debugMode && debugConsole && !(isNull player) : player globalChat "ERA DEBUG INSERTION: helicopter landing branch selected"
"lz_marker" setMarkerText "Helicopters landing at open LZ"
; Landing branch used about half the time. Helipads give OFP a concrete landing target, which is apparently necessary for aircraft with pilots.
hpadP1 = "HeliHEmpty" createVehicle [lzX, lzY, 0]
hpadP2 = "HeliHEmpty" createVehicle [lzX + 70, lzY + 20, 0]
? alliedCount < 1 : goto "heliPadAfterA1"
hpadA1 = "HeliHEmpty" createVehicle [lzX - 70, lzY + 40, 0]
#heliPadAfterA1
? alliedCount < 2 : goto "heliPadAfterA2"
hpadA2 = "HeliHEmpty" createVehicle [lzX - 110, lzY + 65, 0]
#heliPadAfterA2
? alliedCount < 3 : goto "heliPadAfterA3"
hpadA3 = "HeliHEmpty" createVehicle [lzX + 110, lzY + 65, 0]
#heliPadAfterA3
? alliedCount < 4 : goto "heliPadAfterA4"
hpadA4 = "HeliHEmpty" createVehicle [lzX + 170, lzY + 95, 0]
#heliPadAfterA4
playerHeli1 flyInHeight 0
? heliTransportTwoActive : playerHeli2 flyInHeight 0
? !(heliTransportTwoActive) : heliP2 flyInHeight 0
driver playerHeli1 doMove [lzX, lzY, 0]
? heliTransportTwoActive : driver playerHeli2 doMove [lzX + 70, lzY + 20, 0]
? !(heliTransportTwoActive) : driver heliP2 doMove [lzX + 70, lzY + 20, 0]
? alliedCount < 1 : goto "heliLandOrder"
a1heli flyInHeight 0
driver a1heli doMove [lzX - 70, lzY + 40, 0]
? alliedCount < 2 : goto "heliLandOrder"
a2heli flyInHeight 0
driver a2heli doMove [lzX - 110, lzY + 65, 0]
? alliedCount < 3 : goto "heliLandOrder"
a3heli flyInHeight 0
driver a3heli doMove [lzX + 110, lzY + 65, 0]
? alliedCount < 4 : goto "heliLandOrder"
a4heli flyInHeight 0
driver a4heli doMove [lzX + 170, lzY + 95, 0]
#heliLandOrder
~6
playerHeli1 land "GET OUT"
? heliTransportTwoActive : playerHeli2 land "GET OUT"
? !(heliTransportTwoActive) : heliP2 land "GET OUT"
? alliedCount < 1 : goto "heliLandingWait"
a1heli land "GET OUT"
? alliedCount < 2 : goto "heliLandingWait"
a2heli land "GET OUT"
? alliedCount < 3 : goto "heliLandingWait"
a3heli land "GET OUT"
? alliedCount < 4 : goto "heliLandingWait"
a4heli land "GET OUT"
#heliLandingWait
; v129: do not eject until the player transport is genuinely on or very near the ground.
_touchWait = 0
#heliTouchdownCheck
~1
_touchWait = _touchWait + 1
_playerTouchdown = true
? alive playerHeli1 && (getPos playerHeli1 select 2) > 3 : _playerTouchdown = false
? heliTransportTwoActive && alive playerHeli2 && (getPos playerHeli2 select 2) > 3 : _playerTouchdown = false
? _playerTouchdown : goto "dismount"
? _touchWait < 60 : goto "heliTouchdownCheck"
; CWA landing AI occasionally hovers forever. Force only the player transports into a safe low final position after the timeout.
? alive playerHeli1 : playerHeli1 setVelocity [0,0,0]
? alive playerHeli1 : playerHeli1 setPos [lzX, lzY, 0.6]
? heliTransportTwoActive && alive playerHeli2 : playerHeli2 setVelocity [0,0,0]
? heliTransportTwoActive && alive playerHeli2 : playerHeli2 setPos [lzX + 70, lzY + 20, 0.6]
~2
goto "dismount"
#heliParadrop
? debugMode : debugLog "ERA DEBUG INSERTION: aircraft-style paradrop branch selected"
? debugMode && debugConsole && !(isNull player) : player globalChat "ERA DEBUG INSERTION: aircraft-style paradrop branch selected"
"lz_marker" setMarkerText "High-altitude transport drop zone"
_paraExitX = lzX + 1900
_paraExitY = lzY + 1450
playerHeli1 flyInHeight 220
playerHeli1 setDir 53
playerHeli1 setPos [lzX - 180, lzY - 140, 220]
playerHeli1 setVelocity [48,36,0]
driver playerHeli1 doMove [_paraExitX, _paraExitY, 0]
? !(heliTransportTwoActive) : heliP2 flyInHeight 220
? !(heliTransportTwoActive) : heliP2 setDir 53
? !(heliTransportTwoActive) : heliP2 setPos [lzX - 250, lzY - 190, 230]
? !(heliTransportTwoActive) : heliP2 setVelocity [48,36,0]
? !(heliTransportTwoActive) : driver heliP2 doMove [_paraExitX + 150, _paraExitY - 80, 0]
? alliedCount >= 1 : a1heli flyInHeight 220
? alliedCount >= 1 : a1heli setDir 53
? alliedCount >= 1 : a1heli setPos [lzX - 280, lzY - 90, 220]
? alliedCount >= 1 : a1heli setVelocity [48,36,0]
? alliedCount >= 1 : driver a1heli doMove [_paraExitX - 180, _paraExitY + 100, 0]
? alliedCount >= 2 : a2heli flyInHeight 220
? alliedCount >= 2 : a2heli setDir 53
? alliedCount >= 2 : a2heli setPos [lzX - 360, lzY - 130, 225]
? alliedCount >= 2 : a2heli setVelocity [48,36,0]
? alliedCount >= 2 : driver a2heli doMove [_paraExitX - 280, _paraExitY + 180, 0]
? alliedCount >= 3 : a3heli flyInHeight 220
? alliedCount >= 3 : a3heli setDir 53
? alliedCount >= 3 : a3heli setPos [lzX - 440, lzY - 170, 230]
? alliedCount >= 3 : a3heli setVelocity [48,36,0]
? alliedCount >= 3 : driver a3heli doMove [_paraExitX + 220, _paraExitY + 180, 0]
? alliedCount >= 4 : a4heli flyInHeight 220
? alliedCount >= 4 : a4heli setDir 53
? alliedCount >= 4 : a4heli setPos [lzX - 520, lzY - 210, 235]
? alliedCount >= 4 : a4heli setVelocity [48,36,0]
? alliedCount >= 4 : driver a4heli doMove [_paraExitX + 320, _paraExitY + 260, 0]
~2
