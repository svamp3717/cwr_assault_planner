#afterGetOutA4
~10
; v53 safety hold: keep ground transports stopped while infantry finishes getting out / fallback placement runs.
? !(insertionTruck) : goto "skipTruckFuelStop"
truckP1 setFuel 0
truckP2 setFuel 0
? alliedCount < 1 : goto "skipTruckFuelStop"
a1truck setFuel 0
? alliedCount < 2 : goto "skipTruckFuelStop"
a2truck setFuel 0
? alliedCount < 3 : goto "skipTruckFuelStop"
a3truck setFuel 0
? alliedCount < 4 : goto "skipTruckFuelStop"
a4truck setFuel 0
#skipTruckFuelStop
? !(insertionAPC) : goto "skipAPCFuelStop"
apcP1 setFuel 0
apcP2 setFuel 0
supportM113 setFuel 0
? alliedCount < 1 : goto "skipAPCFuelStop"
a1apc setFuel 0
? alliedCount < 2 : goto "skipAPCFuelStop"
a2apc setFuel 0
? alliedCount < 3 : goto "skipAPCFuelStop"
a3apc setFuel 0
? alliedCount < 4 : goto "skipAPCFuelStop"
a4apc setFuel 0
#skipAPCFuelStop
? !(insertionMixed) : goto "skipMixedFuelStop"
apcP1 setFuel 0
apcP2 setFuel 0
supportM113 setFuel 0
? alliedCount < 1 : goto "skipMixedFuelStop"
a1apc setFuel 0
? alliedCount < 2 : goto "skipMixedFuelStop"
a2truck setFuel 0
? alliedCount < 3 : goto "skipMixedFuelStop"
a3apc setFuel 0
? alliedCount < 4 : goto "skipMixedFuelStop"
a4truck setFuel 0
#skipMixedFuelStop
; Work out a simple safe dismount offset. Units are placed on the side away from the target town,
; so if transports continue toward the objective they do not drive through their own infantry.
_backX = -35
? primaryX < lzX : _backX = 35
_backY = -35
? primaryY < lzY : _backY = 35
; Pick base points from the actual transport positions, not raw LZ coordinates.
_b1x = getPos truckP1 select 0
_b1y = getPos truckP1 select 1
_b2x = getPos truckP2 select 0
_b2y = getPos truckP2 select 1
_a1x = getPos a1truck select 0
_a1y = getPos a1truck select 1
_a2x = getPos a2truck select 0
_a2y = getPos a2truck select 1
_a3x = getPos a3truck select 0
_a3y = getPos a3truck select 1
_a4x = getPos a4truck select 0
_a4y = getPos a4truck select 1
? insertionAPC : _b1x = getPos apcP1 select 0
? insertionAPC : _b1y = getPos apcP1 select 1
? insertionAPC : _b2x = getPos apcP2 select 0
? insertionAPC : _b2y = getPos apcP2 select 1
? insertionAPC : _a1x = getPos a1apc select 0
? insertionAPC : _a1y = getPos a1apc select 1
? insertionAPC : _a2x = getPos a2apc select 0
? insertionAPC : _a2y = getPos a2apc select 1
? insertionAPC : _a3x = getPos a3apc select 0
? insertionAPC : _a3y = getPos a3apc select 1
? insertionAPC : _a4x = getPos a4apc select 0
? insertionAPC : _a4y = getPos a4apc select 1
? (insertionHeli || insertionPara) : _b1x = getPos playerHeli1 select 0
? (insertionHeli || insertionPara) : _b1y = getPos playerHeli1 select 1
? (insertionHeli || insertionPara) : _b2x = getPos playerHeli1 select 0
? (insertionHeli || insertionPara) : _b2y = getPos playerHeli1 select 1
? (insertionHeli || insertionPara) && heliTransportTwoActive : _b2x = getPos playerHeli2 select 0
? (insertionHeli || insertionPara) && heliTransportTwoActive : _b2y = getPos playerHeli2 select 1
? (insertionHeli || insertionPara) : _a1x = getPos a1heli select 0
? (insertionHeli || insertionPara) : _a1y = getPos a1heli select 1
? (insertionHeli || insertionPara) : _a2x = getPos a2heli select 0
? (insertionHeli || insertionPara) : _a2y = getPos a2heli select 1
? (insertionHeli || insertionPara) : _a3x = getPos a3heli select 0
? (insertionHeli || insertionPara) : _a3y = getPos a3heli select 1
? (insertionHeli || insertionPara) : _a4x = getPos a4heli select 0
? (insertionHeli || insertionPara) : _a4y = getPos a4heli select 1
? insertionMixed : _b1x = getPos apcP1 select 0
? insertionMixed : _b1y = getPos apcP1 select 1
? insertionMixed : _b2x = getPos apcP2 select 0
? insertionMixed : _b2y = getPos apcP2 select 1
? insertionMixed : _a1x = getPos a1apc select 0
? insertionMixed : _a1y = getPos a1apc select 1
? insertionMixed : _a2x = getPos a2truck select 0
? insertionMixed : _a2y = getPos a2truck select 1
? insertionMixed : _a3x = getPos a3apc select 0
? insertionMixed : _a3y = getPos a3apc select 1
? insertionMixed : _a4x = getPos a4truck select 0
? insertionMixed : _a4y = getPos a4truck select 1
unassignVehicle player
player setPos [_b1x + _backX - 10, _b1y + _backY - 6, 0]
? playerAICount >= 1 : unassignVehicle red2
? playerAICount >= 1 : red2 setPos [_b1x + _backX - 4, _b1y + _backY - 6, 0]
? playerAICount >= 2 : unassignVehicle red3
? playerAICount >= 2 : red3 setPos [_b1x + _backX + 2, _b1y + _backY - 6, 0]
? playerAICount >= 3 : unassignVehicle medic1
? playerAICount >= 3 : medic1 setPos [_b1x + _backX + 8, _b1y + _backY - 6, 0]
? playerAICount >= 4 : unassignVehicle medic2
? playerAICount >= 4 : medic2 setPos [_b1x + _backX - 10, _b1y + _backY + 0, 0]
? playerAICount >= 5 : unassignVehicle red6
? playerAICount >= 5 : red6 setPos [_b1x + _backX - 4, _b1y + _backY + 0, 0]
? playerAICount >= 6 : unassignVehicle red7
? playerAICount >= 6 : red7 setPos [_b2x + _backX - 10, _b2y + _backY - 6, 0]
? playerAICount >= 7 : unassignVehicle red8
? playerAICount >= 7 : red8 setPos [_b2x + _backX - 4, _b2y + _backY - 6, 0]
? playerAICount >= 8 : unassignVehicle red9
? playerAICount >= 8 : red9 setPos [_b2x + _backX + 2, _b2y + _backY - 6, 0]
? playerAICount >= 9 : unassignVehicle red10
? playerAICount >= 9 : red10 setPos [_b2x + _backX + 8, _b2y + _backY - 6, 0]
? playerAICount >= 10 : unassignVehicle red11
? playerAICount >= 10 : red11 setPos [_b2x + _backX - 10, _b2y + _backY + 0, 0]
? playerAICount >= 11 : unassignVehicle red12
? playerAICount >= 11 : red12 setPos [_b2x + _backX - 4, _b2y + _backY + 0, 0]
? alliedCount < 1 : goto "dismountAfterA1"
unassignVehicle a1ldr
a1ldr setPos [_a1x + _backX - 10, _a1y + _backY - 6, 0]
unassignVehicle a1r2
a1r2 setPos [_a1x + _backX - 4, _a1y + _backY - 6, 0]
unassignVehicle a1gren
a1gren setPos [_a1x + _backX + 2, _a1y + _backY - 6, 0]
unassignVehicle a1med
a1med setPos [_a1x + _backX + 8, _a1y + _backY - 6, 0]
unassignVehicle a1mg
a1mg setPos [_a1x + _backX - 10, _a1y + _backY + 0, 0]
unassignVehicle a1at
a1at setPos [_a1x + _backX - 4, _a1y + _backY + 0, 0]
unassignVehicle a1r7
a1r7 setPos [_a1x + _backX + 2, _a1y + _backY + 0, 0]
unassignVehicle a1r8
a1r8 setPos [_a1x + _backX + 8, _a1y + _backY + 0, 0]
#dismountAfterA1
? alliedCount < 2 : goto "dismountAfterA2"
unassignVehicle a2ldr
a2ldr setPos [_a2x + _backX - 10, _a2y + _backY - 6, 0]
unassignVehicle a2r2
a2r2 setPos [_a2x + _backX - 4, _a2y + _backY - 6, 0]
unassignVehicle a2gren
a2gren setPos [_a2x + _backX + 2, _a2y + _backY - 6, 0]
unassignVehicle a2med
a2med setPos [_a2x + _backX + 8, _a2y + _backY - 6, 0]
unassignVehicle a2mg
a2mg setPos [_a2x + _backX - 10, _a2y + _backY + 0, 0]
unassignVehicle a2at
a2at setPos [_a2x + _backX - 4, _a2y + _backY + 0, 0]
unassignVehicle a2r7
a2r7 setPos [_a2x + _backX + 2, _a2y + _backY + 0, 0]
unassignVehicle a2r8
a2r8 setPos [_a2x + _backX + 8, _a2y + _backY + 0, 0]
#dismountAfterA2
? alliedCount < 3 : goto "dismountAfterA3"
unassignVehicle a3ldr
a3ldr setPos [_a3x + _backX - 10, _a3y + _backY - 6, 0]
unassignVehicle a3r2
a3r2 setPos [_a3x + _backX - 4, _a3y + _backY - 6, 0]
unassignVehicle a3gren
a3gren setPos [_a3x + _backX + 2, _a3y + _backY - 6, 0]
unassignVehicle a3med
a3med setPos [_a3x + _backX + 8, _a3y + _backY - 6, 0]
unassignVehicle a3mg
a3mg setPos [_a3x + _backX - 10, _a3y + _backY + 0, 0]
unassignVehicle a3at
a3at setPos [_a3x + _backX - 4, _a3y + _backY + 0, 0]
unassignVehicle a3r7
a3r7 setPos [_a3x + _backX + 2, _a3y + _backY + 0, 0]
unassignVehicle a3r8
a3r8 setPos [_a3x + _backX + 8, _a3y + _backY + 0, 0]
#dismountAfterA3
? alliedCount < 4 : goto "dismountAfterA4"
unassignVehicle a4ldr
a4ldr setPos [_a4x + _backX - 10, _a4y + _backY - 6, 0]
unassignVehicle a4r2
a4r2 setPos [_a4x + _backX - 4, _a4y + _backY - 6, 0]
unassignVehicle a4gren
a4gren setPos [_a4x + _backX + 2, _a4y + _backY - 6, 0]
unassignVehicle a4med
a4med setPos [_a4x + _backX + 8, _a4y + _backY - 6, 0]
unassignVehicle a4mg
a4mg setPos [_a4x + _backX - 10, _a4y + _backY + 0, 0]
unassignVehicle a4at
a4at setPos [_a4x + _backX - 4, _a4y + _backY + 0, 0]
unassignVehicle a4r7
a4r7 setPos [_a4x + _backX + 2, _a4y + _backY + 0, 0]
unassignVehicle a4r8
a4r8 setPos [_a4x + _backX + 8, _a4y + _backY + 0, 0]
#dismountAfterA4
~4
? !(insertionTruck) : goto "skipTruckFuelRestore"
truckP1 setFuel 1
truckP2 setFuel 1
? alliedCount < 1 : goto "skipTruckFuelRestore"
a1truck setFuel 1
? alliedCount < 2 : goto "skipTruckFuelRestore"
a2truck setFuel 1
? alliedCount < 3 : goto "skipTruckFuelRestore"
a3truck setFuel 1
? alliedCount < 4 : goto "skipTruckFuelRestore"
a4truck setFuel 1
#skipTruckFuelRestore
? !(insertionAPC) : goto "skipAPCFuelRestore"
apcP1 setFuel 1
apcP2 setFuel 1
supportM113 setFuel 1
? alliedCount < 1 : goto "skipAPCFuelRestore"
a1apc setFuel 1
? alliedCount < 2 : goto "skipAPCFuelRestore"
a2apc setFuel 1
? alliedCount < 3 : goto "skipAPCFuelRestore"
a3apc setFuel 1
? alliedCount < 4 : goto "skipAPCFuelRestore"
a4apc setFuel 1
#skipAPCFuelRestore
? !(insertionMixed) : goto "skipMixedFuelRestore"
apcP1 setFuel 1
apcP2 setFuel 1
supportM113 setFuel 1
? alliedCount < 1 : goto "skipMixedFuelRestore"
a1apc setFuel 1
? alliedCount < 2 : goto "skipMixedFuelRestore"
a2truck setFuel 1
? alliedCount < 3 : goto "skipMixedFuelRestore"
a3apc setFuel 1
? alliedCount < 4 : goto "skipMixedFuelRestore"
a4truck setFuel 1
#skipMixedFuelRestore
; v125: doStop/stop true clears the previous LZ order. Explicitly release each active transport and give it a new move order.
? (insertionHeli || insertionPara) : goto "afterGroundTransportRelease"
? !(insertionTruck) : goto "releaseTruckDone"
[truckP1, primaryX + 80, primaryY + 20] exec "friendlyGroundTransportRelease.sqs"
[truckP2, primaryX + 95, primaryY + 35] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 1 : [a1truck, primaryX + 65, primaryY - 30] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 2 : [a2truck, primaryX + 50, primaryY - 45] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 3 : [a3truck, primaryX + 35, primaryY - 60] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 4 : [a4truck, primaryX + 20, primaryY - 75] exec "friendlyGroundTransportRelease.sqs"
#releaseTruckDone
? !(insertionAPC) : goto "releaseAPCDone"
[apcP1, primaryX + 80, primaryY + 20] exec "friendlyGroundTransportRelease.sqs"
[apcP2, primaryX + 95, primaryY + 35] exec "friendlyGroundTransportRelease.sqs"
[supportM113, primaryX + 110, primaryY + 50] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 1 : [a1apc, primaryX + 65, primaryY - 30] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 2 : [a2apc, primaryX + 50, primaryY - 45] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 3 : [a3apc, primaryX + 35, primaryY - 60] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 4 : [a4apc, primaryX + 20, primaryY - 75] exec "friendlyGroundTransportRelease.sqs"
#releaseAPCDone
? !(insertionMixed) : goto "releaseMixedDone"
[apcP1, primaryX + 80, primaryY + 20] exec "friendlyGroundTransportRelease.sqs"
[apcP2, primaryX + 95, primaryY + 35] exec "friendlyGroundTransportRelease.sqs"
[supportM113, primaryX + 110, primaryY + 50] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 1 : [a1apc, primaryX + 65, primaryY - 30] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 2 : [a2truck, primaryX + 50, primaryY - 45] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 3 : [a3apc, primaryX + 35, primaryY - 60] exec "friendlyGroundTransportRelease.sqs"
? alliedCount >= 4 : [a4truck, primaryX + 20, primaryY - 75] exec "friendlyGroundTransportRelease.sqs"
#releaseMixedDone
#afterGroundTransportRelease
#insertionFinished
; Landing helicopters lift off after unloading. Paradrop helicopters already started this helper above.
? !((insertionHeli || insertionPara)) : goto "afterHelicopterDepartureStart"
? heliDepartureStarted : goto "afterHelicopterDepartureStart"
_departX = lzX + ((lzX - _airX) * 2)
_departY = lzY + ((lzY - _airY) * 2)
[playerHeli1, lzX, lzY, _departX, _departY] exec "friendlyHelicopterDeparture.sqs"
? heliTransportTwoActive : [playerHeli2, lzX, lzY, _departX + 120, _departY - 80] exec "friendlyHelicopterDeparture.sqs"
? !(heliTransportTwoActive) : [heliP2, lzX, lzY, _departX + 120, _departY - 80] exec "friendlyHelicopterDeparture.sqs"
? alliedCount >= 1 : [a1heli, lzX, lzY, _departX - 120, _departY + 80] exec "friendlyHelicopterDeparture.sqs"
? alliedCount >= 2 : [a2heli, lzX, lzY, _departX - 220, _departY + 140] exec "friendlyHelicopterDeparture.sqs"
? alliedCount >= 3 : [a3heli, lzX, lzY, _departX + 220, _departY + 140] exec "friendlyHelicopterDeparture.sqs"
? alliedCount >= 4 : [a4heli, lzX, lzY, _departX + 320, _departY + 200] exec "friendlyHelicopterDeparture.sqs"
heliDepartureStarted = true
#afterHelicopterDepartureStart
; Runtime landing pads are no longer needed once the helicopters have begun departure.
? !(isNull hpadP1) : deleteVehicle hpadP1
? !(isNull hpadP2) : deleteVehicle hpadP2
? !(isNull hpadA1) : deleteVehicle hpadA1
? !(isNull hpadA2) : deleteVehicle hpadA2
? !(isNull hpadA3) : deleteVehicle hpadA3
? !(isNull hpadA4) : deleteVehicle hpadA4
hpadP1 = objNull
hpadP2 = objNull
hpadA1 = objNull
hpadA2 = objNull
hpadA3 = objNull
hpadA4 = objNull
[] exec "westAmmoBox.sqs"
? debugMode : debugLog "ERA DEBUG INSERTION: player-side squads inserted, ammo box placed"
? debugMode && debugConsole && !(isNull player) : player globalChat "ERA DEBUG INSERTION: player-side squads inserted, ammo box placed"
player addWeapon "Binocular"
player addWeapon "NVGoggles"
insertionComplete = true
[] exec "updateObjectiveMarkerLabels.sqs"
[] exec "alliedSearchDestroy.sqs"
? alliedCount < 1 : goto "moveAfterA1"
a1ldr doMove [primaryX, primaryY, 0]
#moveAfterA1
? alliedCount < 2 : goto "moveAfterA2"
a2ldr doMove [primaryX, primaryY, 0]
#moveAfterA2
? alliedCount < 3 : goto "moveAfterA3"
a3ldr doMove [primaryX, primaryY, 0]
#moveAfterA3
? alliedCount < 4 : goto "moveAfterA4"
a4ldr doMove [primaryX, primaryY, 0]
#moveAfterA4
? supportGround : [] exec "sendGroundSupportPrimary.sqs"
; Air support is now Radio Alpha only. Do not auto-call it after insertion.
exit
