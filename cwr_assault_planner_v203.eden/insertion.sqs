#dismount
"lz_marker" setMarkerText "Dismount area - move to objective"
; v53: ground transports are stopped before any cargo is told to get out.
; Previous builds issued GETOUT first and froze vehicles afterward, which could dump infantry beside moving trucks/APCs.
? (insertionHeli || insertionPara) : goto "afterGroundStopBeforeGetOut"
? debugMode : debugLog "ERA DEBUG INSERTION: stopping ground transports before cargo dismount"
? debugMode && debugConsole && !(isNull player) : player globalChat "ERA DEBUG INSERTION: stopping ground transports before cargo dismount"
