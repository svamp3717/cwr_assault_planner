? playerAICount >= 3 : medic1 moveInCargo playerHeli1
? playerAICount >= 4 : medic2 assignAsCargo playerHeli1
? playerAICount >= 4 : medic2 moveInCargo playerHeli1
? playerAICount >= 5 : red6 assignAsCargo playerHeli1
? playerAICount >= 5 : red6 moveInCargo playerHeli1
? playerAICount >= 6 : red7 assignAsCargo playerHeli2
? playerAICount >= 6 : red7 moveInCargo playerHeli2
? playerAICount >= 7 : red8 assignAsCargo playerHeli2
? playerAICount >= 7 : red8 moveInCargo playerHeli2
? playerAICount >= 8 : red9 assignAsCargo playerHeli2
? playerAICount >= 8 : red9 moveInCargo playerHeli2
? playerAICount >= 9 : red10 assignAsCargo playerHeli2
? playerAICount >= 9 : red10 moveInCargo playerHeli2
? playerAICount >= 10 : red11 assignAsCargo playerHeli2
? playerAICount >= 10 : red11 moveInCargo playerHeli2
? playerAICount >= 11 : red12 assignAsCargo playerHeli2
? playerAICount >= 11 : red12 moveInCargo playerHeli2
#heliPlayerLoaded
? alliedCount < 1 : goto "heliAfterA1"
a1ldr assignAsCargo a1heli
a1ldr moveInCargo a1heli
a1r2 assignAsCargo a1heli
a1r2 moveInCargo a1heli
