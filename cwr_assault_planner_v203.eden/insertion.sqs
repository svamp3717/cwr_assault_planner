a2r7 assignAsCargo a2truck
a2r7 moveInCargo a2truck
a2r8 assignAsCargo a2truck
a2r8 moveInCargo a2truck
#mixedAfterA2
? alliedCount < 3 : goto "mixedAfterA3"
a3apc setFuel 1
a3ldr assignAsCargo a3apc
a3ldr moveInCargo a3apc
a3r2 assignAsCargo a3apc
a3r2 moveInCargo a3apc
a3gren assignAsCargo a3apc
a3gren moveInCargo a3apc
