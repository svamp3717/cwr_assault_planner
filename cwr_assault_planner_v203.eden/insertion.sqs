; Random insertion script. Uses hard placement at LZ to avoid player-in-vehicle trap.
heliDepartureStarted = false
player addWeapon "Binocular"
player addWeapon "NVGoggles"
~1
; Move all possible transports near the selected primary objective.
; Trucks and other non-floating vehicles use dry land staging coordinates chosen per town.
; Only true water vehicles should ever be staged in water, and this mission no longer uses boats.
_startX = landStageX
_startY = landStageY
_airX = airStageX
_airY = airStageY
; Helicopter insertions use the dry staging coordinate as the landing clearing.
; The generic distant LZ may be safe for trucks/APCs but can be trees for helicopters.
; Unused ground transports are pushed away so they do not sit on the heli pads.
? insertionPara : goto "heliOpenLZ"
? insertionHeli : goto "heliOpenLZ"
goto "afterHeliOpenLZ"
#heliOpenLZ
; Pick one of three curated open helicopter LZs for the selected objective town.
_r = random 3
? _r < 1 : goto "heliLzOne"
? _r < 2 : goto "heliLzTwo"
goto "heliLzThree"
#heliLzOne
lzX = heliLz1X
lzY = heliLz1Y
goto "heliLzChosen"
#heliLzTwo
lzX = heliLz2X
lzY = heliLz2Y
goto "heliLzChosen"
#heliLzThree
lzX = heliLz3X
lzY = heliLz3Y
#heliLzChosen
_startX = landStageX + 350
_startY = landStageY + 220
; v126: lengthen the helicopter approach so transports begin farther from the objective area.
_airX = lzX - 1250
_airY = lzY - 950
"lz_marker" setMarkerPos [lzX, lzY, 0]
"lz_marker" setMarkerText format ["LZ: helicopter open field / %1", supportAirLabel]
#afterHeliOpenLZ
? debugMode : debugLog format ["ERA DEBUG INSERTION: %1 via %2 to LZ %3,%4", insertionLabel, approachLabel, lzX, lzY]
? debugMode && debugConsole && !(isNull player) : player globalChat format ["ERA DEBUG INSERTION: %1 via %2 to LZ %3,%4", insertionLabel, approachLabel, lzX, lzY]
? insertionFoot : goto "footInsertion"
; v127: stage trucks as one deterministic road-aligned column. APC staging remains unchanged.
? !(insertionTruck) : goto "truckRoadStageFullDone"
friendlyTruckRoadStageComplete = false
[truckP1, truckStageX, truckStageY, truckStageDir, 0] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
friendlyTruckRoadStageComplete = false
[truckP2, truckStageX, truckStageY, truckStageDir, 1] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
? alliedCount < 1 : goto "truckRoadStageFullDone"
friendlyTruckRoadStageComplete = false
[a1truck, truckStageX, truckStageY, truckStageDir, 2] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
? alliedCount < 2 : goto "truckRoadStageFullDone"
friendlyTruckRoadStageComplete = false
[a2truck, truckStageX, truckStageY, truckStageDir, 3] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
? alliedCount < 3 : goto "truckRoadStageFullDone"
friendlyTruckRoadStageComplete = false
[a3truck, truckStageX, truckStageY, truckStageDir, 4] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
? alliedCount < 4 : goto "truckRoadStageFullDone"
friendlyTruckRoadStageComplete = false
[a4truck, truckStageX, truckStageY, truckStageDir, 5] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
#truckRoadStageFullDone
? !(insertionMixed) : goto "truckRoadStageMixedDone"
? alliedCount < 2 : goto "truckRoadStageMixedDone"
friendlyTruckRoadStageComplete = false
[a2truck, truckStageX, truckStageY, truckStageDir, 0] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
? alliedCount < 4 : goto "truckRoadStageMixedDone"
friendlyTruckRoadStageComplete = false
[a4truck, truckStageX, truckStageY, truckStageDir, 1] exec "friendlyTruckRoadStage.sqs"
@ friendlyTruckRoadStageComplete
#truckRoadStageMixedDone
apcP1 setPos [_startX, _startY + 35, 0]
apcP2 setPos [_startX + 30, _startY + 40, 0]
? insertionAPC : supportM113 setPos [_startX + 65, _startY + 45, 0]
? insertionMixed : supportM113 setPos [_startX + 65, _startY + 45, 0]
; v125: helicopters remain at their safe runtime spawn points while all cargo boards.
; They are moved to the airborne start point only after rotor spin-up and loading are complete.
a1apc setPos [_startX - 50, _startY + 55, 0]
a2apc setPos [_startX - 80, _startY + 70, 0]
a3apc setPos [_startX - 110, _startY + 85, 0]
a4apc setPos [_startX - 140, _startY + 100, 0]
; v125: no airborne launch occurs before boarding.
~1
? insertionTruck : goto "loadTruck"
? insertionAPC : goto "loadAPC"
? insertionPara : goto "loadHeli"
goto "loadHeli"
#footInsertion
; v81: Delegate to the synchronized dedicated foot insertion script.
[] exec "footInsertion.sqs"
exit

#loadTruck
player assignAsCargo truckP1
player moveInCargo truckP1
? playerAICount >= 1 : red2 assignAsCargo truckP1
? playerAICount >= 1 : red2 moveInCargo truckP1
? playerAICount >= 2 : red3 assignAsCargo truckP1
? playerAICount >= 2 : red3 moveInCargo truckP1
? playerAICount >= 3 : medic1 assignAsCargo truckP1
? playerAICount >= 3 : medic1 moveInCargo truckP1
? playerAICount >= 4 : medic2 assignAsCargo truckP1
? playerAICount >= 4 : medic2 moveInCargo truckP1
? playerAICount >= 5 : red6 assignAsCargo truckP1
? playerAICount >= 5 : red6 moveInCargo truckP1
? playerAICount >= 6 : red7 assignAsCargo truckP2
? playerAICount >= 6 : red7 moveInCargo truckP2
? playerAICount >= 7 : red8 assignAsCargo truckP2
? playerAICount >= 7 : red8 moveInCargo truckP2
? playerAICount >= 8 : red9 assignAsCargo truckP2
? playerAICount >= 8 : red9 moveInCargo truckP2
? playerAICount >= 9 : red10 assignAsCargo truckP2
? playerAICount >= 9 : red10 moveInCargo truckP2
? playerAICount >= 10 : red11 assignAsCargo truckP2
? playerAICount >= 10 : red11 moveInCargo truckP2
? playerAICount >= 11 : red12 assignAsCargo truckP2
? playerAICount >= 11 : red12 moveInCargo truckP2
? alliedCount < 1 : goto "truckAfterA1"
a1ldr assignAsCargo a1truck
a1ldr moveInCargo a1truck
a1r2 assignAsCargo a1truck
a1r2 moveInCargo a1truck
a1gren assignAsCargo a1truck
a1gren moveInCargo a1truck
a1med assignAsCargo a1truck
a1med moveInCargo a1truck
a1mg assignAsCargo a1truck
a1mg moveInCargo a1truck
a1at assignAsCargo a1truck
a1at moveInCargo a1truck
a1r7 assignAsCargo a1truck
a1r7 moveInCargo a1truck
a1r8 assignAsCargo a1truck
a1r8 moveInCargo a1truck
#truckAfterA1
? alliedCount < 2 : goto "truckAfterA2"
a2ldr assignAsCargo a2truck
a2ldr moveInCargo a2truck
a2r2 assignAsCargo a2truck
a2r2 moveInCargo a2truck
a2gren assignAsCargo a2truck
a2gren moveInCargo a2truck
a2med assignAsCargo a2truck
a2med moveInCargo a2truck
a2mg assignAsCargo a2truck
a2mg moveInCargo a2truck
a2at assignAsCargo a2truck
a2at moveInCargo a2truck
a2r7 assignAsCargo a2truck
a2r7 moveInCargo a2truck
a2r8 assignAsCargo a2truck
a2r8 moveInCargo a2truck
#truckAfterA2
? alliedCount < 3 : goto "truckAfterA3"
a3ldr assignAsCargo a3truck
a3ldr moveInCargo a3truck
a3r2 assignAsCargo a3truck
a3r2 moveInCargo a3truck
a3gren assignAsCargo a3truck
a3gren moveInCargo a3truck
a3med assignAsCargo a3truck
a3med moveInCargo a3truck
a3mg assignAsCargo a3truck
a3mg moveInCargo a3truck
a3at assignAsCargo a3truck
a3at moveInCargo a3truck
a3r7 assignAsCargo a3truck
a3r7 moveInCargo a3truck
a3r8 assignAsCargo a3truck
a3r8 moveInCargo a3truck
#truckAfterA3
? alliedCount < 4 : goto "truckAfterA4"
a4ldr assignAsCargo a4truck
a4ldr moveInCargo a4truck
a4r2 assignAsCargo a4truck
a4r2 moveInCargo a4truck
a4gren assignAsCargo a4truck
a4gren moveInCargo a4truck
a4med assignAsCargo a4truck
a4med moveInCargo a4truck
a4mg assignAsCargo a4truck
a4mg moveInCargo a4truck
a4at assignAsCargo a4truck
a4at moveInCargo a4truck
a4r7 assignAsCargo a4truck
a4r7 moveInCargo a4truck
a4r8 assignAsCargo a4truck
a4r8 moveInCargo a4truck
#truckAfterA4
truckP1 setFuel 1
truckP2 setFuel 1
[truckP1, truckStageDir, lzX, lzY] exec "friendlyTruckRoadMove.sqs"
[truckP2, truckStageDir, lzX + 20, lzY + 5] exec "friendlyTruckRoadMove.sqs"
? alliedCount < 1 : goto "truckMoveDone"
[a1truck, truckStageDir, lzX - 35, lzY + 20] exec "friendlyTruckRoadMove.sqs"
? alliedCount < 2 : goto "truckMoveDone"
[a2truck, truckStageDir, lzX - 55, lzY + 35] exec "friendlyTruckRoadMove.sqs"
? alliedCount < 3 : goto "truckMoveDone"
[a3truck, truckStageDir, lzX - 75, lzY + 50] exec "friendlyTruckRoadMove.sqs"
? alliedCount < 4 : goto "truckMoveDone"
[a4truck, truckStageDir, lzX - 95, lzY + 65] exec "friendlyTruckRoadMove.sqs"
#truckMoveDone
leadTransport = truckP1
goto "waitArrival"
#loadAPC
player assignAsCargo apcP1
player moveInCargo apcP1
? playerAICount >= 1 : red2 assignAsCargo apcP1
? playerAICount >= 1 : red2 moveInCargo apcP1
? playerAICount >= 2 : red3 assignAsCargo apcP1
? playerAICount >= 2 : red3 moveInCargo apcP1
