? playerAICount >= 9 : red10 assignAsCargo playerHeli1
? playerAICount >= 9 : red10 moveInCargo playerHeli1
? playerAICount >= 10 : red11 assignAsCargo playerHeli1
? playerAICount >= 10 : red11 moveInCargo playerHeli1
? playerAICount >= 11 : red12 assignAsCargo playerHeli1
? playerAICount >= 11 : red12 moveInCargo playerHeli1
goto "heliPlayerLoaded"
#loadHeliSplit
; v51 UH-60 mode: player squad is split across two dedicated UH-60 transports.
heliTransportTwoActive = true
playerHeli1 = heliU1
playerHeli2 = heliU2
heliU1 flyInHeight 130
heliU2 flyInHeight 130
player assignAsCargo playerHeli1
player moveInCargo playerHeli1
? playerAICount >= 1 : red2 assignAsCargo playerHeli1
? playerAICount >= 1 : red2 moveInCargo playerHeli1
? playerAICount >= 2 : red3 assignAsCargo playerHeli1
? playerAICount >= 2 : red3 moveInCargo playerHeli1
