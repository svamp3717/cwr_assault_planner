a3med assignAsCargo a3apc
a3med moveInCargo a3apc
a3mg assignAsCargo a3apc
a3mg moveInCargo a3apc
a3at assignAsCargo a3apc
a3at moveInCargo a3apc
a3r7 assignAsCargo a3apc
a3r7 moveInCargo a3apc
a3r8 assignAsCargo a3apc
a3r8 moveInCargo a3apc
#apcAfterA3
? alliedCount < 4 : goto "apcAfterA4"
a4ldr assignAsCargo a4apc
a4ldr moveInCargo a4apc
a4r2 assignAsCargo a4apc
a4r2 moveInCargo a4apc
a4gren assignAsCargo a4apc
a4gren moveInCargo a4apc
a4med assignAsCargo a4apc
a4med moveInCargo a4apc
a4mg assignAsCargo a4apc
a4mg moveInCargo a4apc
a4at assignAsCargo a4apc
