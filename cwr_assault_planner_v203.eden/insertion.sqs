? playerAICount >= 10 : red11 moveInCargo apcP2
? playerAICount >= 11 : red12 assignAsCargo apcP2
? playerAICount >= 11 : red12 moveInCargo apcP2
? alliedCount < 1 : goto "apcAfterA1"
a1ldr assignAsCargo a1apc
a1ldr moveInCargo a1apc
a1r2 assignAsCargo a1apc
a1r2 moveInCargo a1apc
a1gren assignAsCargo a1apc
