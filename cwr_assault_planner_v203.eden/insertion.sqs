? playerAICount >= 5 : red6 moveInCargo apcP1
? playerAICount >= 6 : red7 assignAsCargo apcP2
? playerAICount >= 6 : red7 moveInCargo apcP2
? playerAICount >= 7 : red8 assignAsCargo apcP2
? playerAICount >= 7 : red8 moveInCargo apcP2
? playerAICount >= 8 : red9 assignAsCargo apcP2
? playerAICount >= 8 : red9 moveInCargo apcP2
