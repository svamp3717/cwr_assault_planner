; FRevive - optional, bounded shore recovery for CWA 1.99.
; Args: [corpse, suspended replacement]. Called once per death by Start.sqs.
; Disabled by default for world ports. Never move a dry corpse or another soldier.
_body = _this select 0
_replacement = _this select 1
? !FREVIVE_ANTI_WATER : exit
? isNull _body || isNull _replacement : exit
? !local _body || !local _replacement : exit
? alive _body || !alive _replacement : exit
? vehicle _body != _body : exit
? (getPosASL _body select 2) >= -0.5 : exit

; Give a falling/ejected corpse up to 3 seconds to settle, never wait forever.
_deadline = time + 3
#settling
~0.1
? isNull _body || isNull _replacement : exit
? !local _body || !local _replacement || alive _body || !alive _replacement : exit
? !FREVIVE_ANTI_WATER || (getPos _replacement select 2) < 7000 || getDammage _replacement > 0 : exit
? (getPosASL _body select 2) >= -0.5 : exit
_vel = velocity _body
? abs (_vel select 0) < 0.1 && abs (_vel select 1) < 0.1 && abs (_vel select 2) < 0.1 : goto "settled"
? time >= _deadline : exit
goto "settling"

#settled
_origin = getPosASL _body
_ox = _origin select 0
_oy = _origin select 1
; No shared measurement object: every job owns its own local probe.
_probe = "PipeBomb" camCreate _origin
? isNull _probe : exit
; Probe the corpse's XY at true sea level. A negative relative Z indicates
; the sea plane is beneath the local ground. Treat that as land, not water.
_probe setPosASL [_ox, _oy, 0]
? (getPos _probe select 2) < -0.25 : goto "cleanup"

; Search concentric rings, at most 600 m, only inside the configured world.
; Yield each ring and cancel if the body moves, revival starts, or ownership changes.
_radius = 20
#ring
~0.01
? !FREVIVE_ANTI_WATER : goto "cleanup"
? isNull _body || isNull _replacement : goto "cleanup"
? !local _body || !local _replacement || alive _body || !alive _replacement : goto "cleanup"
? (getPos _replacement select 2) < 7000 || getDammage _replacement > 0 : goto "cleanup"
? (getPosASL _body select 2) >= -0.5 : goto "cleanup"
? abs ((getPosASL _body select 0) - _ox) > 2 || abs ((getPosASL _body select 1) - _oy) > 2 : goto "cleanup"
_dir = 0

#candidate
_x = _ox + (sin _dir * _radius)
_y = _oy + (cos _dir * _radius)
? _x < worldMinX + 5 || _x > worldMaxX - 5 || _y < worldMinY + 5 || _y > worldMaxY - 5 : goto "next"
_probe setPosASL [_x, _y, 0]
; A sea-level probe more than 2.4 m below local ground indicates dry land.
? (getPos _probe select 2) >= -2.4 : goto "next"
? abs ((getPosASL _probe select 0) - _x) > 2 || abs ((getPosASL _probe select 1) - _y) > 2 : goto "next"
goto "move"

#next
_dir = _dir + 30
? _dir < 360 : goto "candidate"
_radius = _radius + 20
? _radius <= 600 : goto "ring"
; No suitable shore: leave the corpse alone. Never teleport to another unit.
goto "cleanup"

#move
; Check again immediately before the only physical relocation.
? !FREVIVE_ANTI_WATER || isNull _body || isNull _replacement : goto "cleanup"
? !local _body || !local _replacement || alive _body || !alive _replacement : goto "cleanup"
? (getPos _replacement select 2) < 7000 || getDammage _replacement > 0 : goto "cleanup"
? (getPosASL _body select 2) >= -0.5 : goto "cleanup"
? abs ((getPosASL _body select 0) - _ox) > 2 || abs ((getPosASL _body select 1) - _oy) > 2 : goto "cleanup"
_body setPos [_x, _y, 0]
_body setVelocity [0,0,0]

#cleanup
deleteVehicle _probe
exit
