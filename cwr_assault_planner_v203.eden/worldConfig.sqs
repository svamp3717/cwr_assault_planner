["Lamentin",[1286.012695,5952.956543]],
["Le Moule",[2611.707031,5410.354004]],
["Provins",[5492.664551,6089.755371]],
["Figari",[5301.566406,5383.737305]],
["Chotain",[7095.247559,6014.785645]],
["Laruns",[7556.217773,5574.715332]],
["Morton",[5023.082031,3962.836426]],
["Levie",[7547.413086,4731.172852]],
["Levie Base",[7508.561523,4172.744141]],
["Durras",[8824.353516,2710.789551]],
["Vernon",[9119.220703,2181.746582]],
["Saint Pierre",[9623.721680,1592.533081]],
["Regina",[7186.205078,2344.993652]],
["Area 01",[2335.919922,6851.415039]],
["Area 02",[2843.642334,6422.577148]],
["Area 03",[3420.656250,4391.833984]],
