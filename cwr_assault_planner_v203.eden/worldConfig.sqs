; World-specific mission data.
; To move Assault Planner to another island, edit this file instead of placing 33 site markers by hand.
; Each entry is [location name, [x, y]]. The name and position values can be copied from the world's config.cpp class Names entries.
;
; When false (recommended), site_0..site_N are generated/repositioned from this file at runtime.
; When true, the mission uses editor-placed site_* markers instead, preserving the old workflow.
worldConfigReady = false
worldUseEditorLocationMarkers = false
worldName = "Everon"

; Mission staging/base coordinate used by scripts that reference missionBaseX/Y.
missionBaseX = 10875.000000
missionBaseY = 11700.000000

worldLocations = [
["Saint Phillipe",[4682.183105,10726.460938]],
["Meaux",[4517.515625,9474.873047]],
["Tyrone",[4937.587891,9052.875000]],
["Gravette",[4179.453125,7810.764160]],
["Entre Deux",[5708.762207,7085.689941]],
["Montignac",[4913.112793,6958.953125]],
["Lamentin",[1286.012695,5952.956543]],
["Le Moule",[2611.707031,5410.354004]],
["Provins",[5492.664551,6089.755371]],
["Figari",[5301.566406,5383.737305]],
["Chotain",[7095.247559,6014.785645]],
["Laruns",[7556.217773,5574.715332]],
["Morton",[5023.082031,3962.836426]],
["Levie",[7547.413086,4731.172852]],
["Levie Base",[7508.561523,4172.744141]],
["Durras",[8824.353516,2710.789551]],
["Vernon",[9119.220703,2181.746582]],
["Saint Pierre",[9623.721680,1592.533081]],
["Regina",[7186.205078,2344.993652]],
["Area 01",[2335.919922,6851.415039]],
["Area 02",[2843.642334,6422.577148]],
["Area 03",[3420.656250,4391.833984]],
["Area 04",[2109.545166,4714.759766]],
["Area 05",[7258.341797,6740.263672]],
["Area 06",[6493.989746,8422.560547]],
["Orion Base",[4899.532227,11995.522461]],
["Area 07",[11002.472656,1573.534180]],
["Area 08",[8758.515625,3885.390137]],
["Area 09",[8873.225586,4436.742188]],
["Buffalo Base",[4067.632324,6716.370605]],
["Area 10",[3888.371094,8320.095703]],
["Saint Phillipe Camp",[5500.154297,10215.820312]],
["Castle Ruins",[9383.858398,1059.791016]]
]

; Keep the legacy marker-name interface so the existing CWA-safe mission scripts do not need a large rewrite.
missionLocationMarkers = ["site_0","site_1","site_2","site_3","site_4","site_5","site_6","site_7","site_8","site_9","site_10","site_11","site_12","site_13","site_14","site_15","site_16","site_17","site_18","site_19","site_20","site_21","site_22","site_23","site_24","site_25","site_26","site_27","site_28","site_29","site_30","site_31","site_32"]
missionLocationLabels = []
_i = 0
#worldLocationLoop
? _i >= count worldLocations : goto "worldLocationDone"
_entry = worldLocations select _i
_label = _entry select 0
_pos = _entry select 1
_marker = missionLocationMarkers select _i
missionLocationLabels = missionLocationLabels + [_label]
? worldUseEditorLocationMarkers : goto "worldLocationNext"
createMarker [_marker, _pos]
_marker setMarkerPos _pos
_marker setMarkerType "Empty"
_marker setMarkerText ""
_marker setMarkerColor "ColorBlack"
#worldLocationNext
_i = _i + 1
goto "worldLocationLoop"

#worldLocationDone
missionLocationTotal = count missionLocationMarkers
missionTownMarkers = missionLocationMarkers
missionTownLabels = missionLocationLabels
missionTownTotal = missionLocationTotal
missionTrafficMarkers = missionLocationMarkers
missionTrafficLabels = missionLocationLabels
missionTrafficTotal = missionLocationTotal
missionUnnamedTrafficMarkers = []
missionUnnamedTrafficLabels = []
missionUnnamedTrafficTotal = 0
worldConfigReady = true
exit
