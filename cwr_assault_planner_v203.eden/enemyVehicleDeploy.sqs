; v90: move surviving editor-placed enemy vehicles to safe objective outskirts.
; No destroy-and-recreate replacement is used. This preserves class, crew and mission object identity.
enemyVehicleDeployComplete = false
? !(enemyGroundVehicles) : goto "deployFinished"
? enemyEast : goto "deployEast"
goto "deployResistance"
#deployEast
? townCount < 1 : goto "eastAfter1"
