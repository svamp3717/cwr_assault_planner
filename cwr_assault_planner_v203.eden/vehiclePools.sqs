; v48 modular vehicle pool selector.
; v120: Runtime ground combat pools from all_ww4_vehs.txt.
; Side-specific E/R variants are used where available. West, desert, civilian,
; aircraft, boat, ambulance, repair/fuel/ammo and static-weapon classes are excluded.
enemyGroundVehiclePoolsReady = false
enemyEastAPCVehiclePool = ["WW4EXT_M113E","WW4EXT_BMP","WW4EXT_BMP2","WW4EXT_BMP2_CW","WW4EXT_BMP3","WW4EXT_BMD3","WW4EXT_BTR80","WW4EXT_BTR80_CW","WW4EXT_BMPExportE","WW4EXT_BMP2ExportE","WW4EXT_BMP3ExportE","WW4EXT_BTR80ExportE"]
enemyEastLightVehiclePool = ["WW4EXT_JeepMGE","WW4EXT_BRDM","WW4EXT_BRDM_MG","WW4EXT_BRDM2","WW4EXT_BRDM2M","WW4EXT_BRDM2ExportE","WW4EXT_Zil157MGE","WW4EXT_ToyotaDshk1E","WW4EXT_ToyotaDshk2E","WW4EXT_ToyotaDshk3E","WW4EXT_ToyotaDshk4E"]
