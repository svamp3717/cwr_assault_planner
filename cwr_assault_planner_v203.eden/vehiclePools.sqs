; v48 modular vehicle pool selector.
; v120: Runtime ground combat pools from all_ww4_vehs.txt.
; Side-specific E/R variants are used where available. West, desert, civilian,
; aircraft, boat, ambulance, repair/fuel/ammo and static-weapon classes are excluded.
enemyGroundVehiclePoolsReady = false










; v133: randomized ground reinforcement transports. Armed APCs and unarmed trucks share the same cargo-wave role.


enemyGroundVehiclePoolsReady = true

; WEST air support class selection. The selected aircraft is created later by friendlyRuntimeSupport.sqs.
supportAirClass = assetClassWestCobra
supportAirSelection = 0
supportAirName = assetNameWestCobra
enemyAttackClass = assetClassEastAttackHeli
enemyAttackVehicle = objNull
enemyAttackName = assetNameEastAttackHeli
? !(supportAir) : goto "westAirDisabled"
_r = random 5
? _r < 1 : goto "westAH1Runtime"
? _r < 2 : goto "westAH64Runtime"
? _r < 3 : goto "westA10Runtime"
? _r < 4 : goto "westA10LGBRuntime"
goto "westOH58Runtime"
#westAH1Runtime
supportAirClass = assetClassWestCobra
supportAirSelection = 0
supportAirName = assetNameWestCobra
goto "westAirRuntimeChosen"
#westAH64Runtime
supportAirClass = assetClassWestApache
supportAirSelection = 1
supportAirName = assetNameWestApache
goto "westAirRuntimeChosen"
#westA10Runtime
supportAirClass = assetClassWestAttackJet
supportAirSelection = 2
supportAirName = assetNameWestAttackJet
goto "westAirRuntimeChosen"
#westA10LGBRuntime
supportAirClass = assetClassWestLaserJet
supportAirSelection = 3
supportAirName = assetNameWestLaserJet
goto "westAirRuntimeChosen"
#westOH58Runtime
supportAirClass = assetClassWestKiowa
supportAirSelection = 4
supportAirName = assetNameWestKiowa
#westAirRuntimeChosen
supportAirLabel = format ["%1 available - Radio Alpha", supportAirName]
? debugMode : debugLog format ["ERA DEBUG VEHICLE POOL: WEST runtime air support selected %1", supportAirName]
goto "enemyAirPool"
#westAirDisabled
supportAirLabel = "no air support"

#enemyAirPool
; v129: select a class only. enemyRuntimeReserves.sqs creates the chosen aircraft and crew.
enemyAttackClass = assetClassEastAttackHeli
enemyAttackName = assetNameEastAttackHeli
? !(enemyAirSupport) : exit
_r = random 3
? _r < 1 : goto "enemyMi24Runtime"
? _r < 2 : goto "enemySu25Runtime"
goto "enemyV80Runtime"
#enemyMi24Runtime
enemyAttackClass = assetClassEastAttackHeli
enemyAttackName = assetNameEastAttackHeli
goto "enemyAirChosenRuntime"
#enemySu25Runtime
enemyAttackClass = assetClassEastAttackJet
enemyAttackName = assetNameEastAttackJet
goto "enemyAirChosenRuntime"
#enemyV80Runtime
enemyAttackClass = assetClassEastKamov
enemyAttackName = assetNameEastKamov
#enemyAirChosenRuntime
? debugMode : debugLog format ["ERA DEBUG VEHICLE POOL: runtime enemy attack air selected %1", enemyAttackName]
? debugMode && debugConsole && !(isNull player) : player globalChat format ["ERA DEBUG VEHICLE POOL: runtime enemy attack air selected %1", enemyAttackName]
exit
