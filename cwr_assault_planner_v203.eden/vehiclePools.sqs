enemyGroundVehiclePoolsReady = true

; WEST air support class selection. The selected aircraft is created later by friendlyRuntimeSupport.sqs.
supportAirClass = "AH1"
supportAirSelection = 0
supportAirName = "AH-1 Cobra"
enemyAttackClass = "Mi24"
enemyAttackVehicle = objNull
enemyAttackName = "Mi-24"
? !(supportAir) : goto "westAirDisabled"
_r = random 5
? _r < 1 : goto "westAH1Runtime"
? _r < 2 : goto "westAH64Runtime"
? _r < 3 : goto "westA10Runtime"
? _r < 4 : goto "westA10LGBRuntime"
goto "westOH58Runtime"
#westAH1Runtime
supportAirClass = "AH1"
supportAirSelection = 0
supportAirName = "AH-1 Cobra"
goto "westAirRuntimeChosen"
#westAH64Runtime
supportAirClass = "AH64"
supportAirSelection = 1
supportAirName = "AH-64 Apache"
goto "westAirRuntimeChosen"
#westA10Runtime
supportAirClass = "WW4EXT_A10BIS"
supportAirSelection = 2
supportAirName = "A-10"
goto "westAirRuntimeChosen"
#westA10LGBRuntime
supportAirClass = "WW4EXT_A10LGBBIS"
supportAirSelection = 3
supportAirName = "A-10 LGB"
goto "westAirRuntimeChosen"
#westOH58Runtime
supportAirClass = "OH58"
supportAirSelection = 4
supportAirName = "OH-58 Kiowa"
#westAirRuntimeChosen
supportAirLabel = format ["%1 available - Radio Alpha", supportAirName]
? debugMode : debugLog format ["ERA DEBUG VEHICLE POOL: WEST runtime air support selected %1", supportAirName]
goto "enemyAirPool"
#westAirDisabled
supportAirLabel = "no air support"

#enemyAirPool
; v129: select a class only. enemyRuntimeReserves.sqs creates the chosen aircraft and crew.
enemyAttackClass = "Mi24"
enemyAttackName = "Mi-24"
? !(enemyAirSupport) : exit
_r = random 3
? _r < 1 : goto "enemyMi24Runtime"
? _r < 2 : goto "enemySu25Runtime"
goto "enemyV80Runtime"
#enemyMi24Runtime
enemyAttackClass = "Mi24"
enemyAttackName = "Mi-24"
goto "enemyAirChosenRuntime"
#enemySu25Runtime
enemyAttackClass = "WW4EXT_Su25_CW"
enemyAttackName = "Su-25"
goto "enemyAirChosenRuntime"
#enemyV80Runtime
enemyAttackClass = "Kamov"
enemyAttackName = "V-80 / Kamov"
#enemyAirChosenRuntime
? debugMode : debugLog format ["ERA DEBUG VEHICLE POOL: runtime enemy attack air selected %1", enemyAttackName]
? debugMode && debugConsole && !(isNull player) : player globalChat format ["ERA DEBUG VEHICLE POOL: runtime enemy attack air selected %1", enemyAttackName]
exit
