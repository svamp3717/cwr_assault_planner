enemyEastReinforcementTransportPool = ["WW4EXT_BTR80","WW4EXT_BTR80_CW","WW4EXT_BTR80ExportE","WW4EXT_BMP","WW4EXT_BMP2","WW4EXT_BMP2_CW","WW4EXT_BMPExportE","WW4EXT_BMP2ExportE","WW4EXT_UralE","WW4EXT_PV3SE"]
