_p = getPos _old
_d = getDir _old
deleteVehicle (driver _old)
deleteVehicle (gunner _old)
deleteVehicle (commander _old)
deleteVehicle _old
_new = "WW4EXT_UAZ_CW" createVehicle _p
_new setDir _d
_new setFuel 1
s1Eveh2 = _new
