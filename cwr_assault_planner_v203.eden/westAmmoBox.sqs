; v129: drop the empty Mission Arsenal access box beside the playable squad's actual disembark/landing point.
; The box supplies common allied magazines and also opens the Mission Arsenal interface.
_dropUnit = plr
? !(alive _dropUnit) && alive red2 : _dropUnit = red2
? !(alive _dropUnit) && alive red3 : _dropUnit = red3
? !(alive _dropUnit) && alive medic1 : _dropUnit = medic1
? !(alive _dropUnit) && alive medic2 : _dropUnit = medic2
? !(alive _dropUnit) && alive red6 : _dropUnit = red6
? !(alive _dropUnit) && alive red7 : _dropUnit = red7
? !(alive _dropUnit) && alive red8 : _dropUnit = red8
? !(alive _dropUnit) && alive red9 : _dropUnit = red9
? !(alive _dropUnit) && alive red10 : _dropUnit = red10
? !(alive _dropUnit) && alive red11 : _dropUnit = red11
? !(alive _dropUnit) && alive red12 : _dropUnit = red12
_wait = 0
#waitForActualDropPoint
? !(alive _dropUnit) : goto "fallbackBoxPoint"
_dropPos = getPos _dropUnit
_dropAlt = _dropPos select 2
? (vehicle _dropUnit == _dropUnit) && _dropAlt <= 3 : goto "usePlayerDropPoint"
? _wait >= 100 : goto "fallbackBoxPoint"
~1
_wait = _wait + 1
goto "waitForActualDropPoint"
#usePlayerDropPoint
boxX = (_dropPos select 0) + 7
boxY = (_dropPos select 1) - 4
goto "createOrMoveBox"
#fallbackBoxPoint
boxX = lzX + 10
boxY = lzY - 8
#createOrMoveBox
? supplyBoxMade : goto "moveSupplyBox"
westSupplyBox = assetClassWestAmmoBox createVehicle [boxX, boxY, 0]
supplyBoxMade = true
goto "placeSupplyBox"
#moveSupplyBox
westSupplyBox setPos [boxX, boxY, 0]
#placeSupplyBox
clearWeaponCargo westSupplyBox
clearMagazineCargo westSupplyBox
westSupplyBox addMagazineCargo [assetClassWestRifleMagazine,48]
westSupplyBox addMagazineCargo [assetClassWestGrenadeLauncherMagazine,18]
westSupplyBox addMagazineCargo [assetClassWestLightMachinegunMagazine,10]
westSupplyBox addMagazineCargo [assetClassWestMachinegunMagazine,6]
westSupplyBox addMagazineCargo [assetClassWestSemiAutoSniperMagazine,8]
westSupplyBox addMagazineCargo [assetClassWestBoltActionSniperMagazine,8]
westSupplyBox addMagazineCargo [assetClassWestLightAT,8]
westSupplyBox addMagazineCargo [assetClassWestHeavyAT,4]
; Vanilla weapons and magazines are supplied through the Mission Arsenal GUI only.
westSupplyBox addMagazineCargo [assetClassHandGrenade,24]
westSupplyBox addMagazineCargo [assetClassSmokeShell,12]
westSupplyBox addMagazineCargo [assetClassSmokeShellGreen,6]
westSupplyBox addMagazineCargo [assetClassPipeBomb,6]
westSupplyBox addMagazineCargo [assetClassTimeBomb,6]
westSupplyBox addMagazineCargo [assetClassMine,6]
westSupplyBox addMagazineCargo [assetClassMineE,6]
"box_marker" setMarkerPos [boxX, boxY, 0]
"box_marker" setMarkerText "Mission Arsenal"
arsenalBox = westSupplyBox
mpSupplyBoxReady = true
publicVariable "westSupplyBox"
publicVariable "mpSupplyBoxReady"
? !(mpMode) : WW4_ArsenalBoxAction = westSupplyBox addAction ["Open Mission Arsenal","ww4_arsenal\open.sqs"]
? debugMode : debugLog format ["ERA DEBUG SUPPLY: Mission Arsenal box delivered at %1,%2 after disembark", boxX, boxY]
? debugMode && debugConsole && !(isNull player) : player globalChat "ERA DEBUG SUPPLY: Mission Arsenal box delivered at squad disembark point"
exit
