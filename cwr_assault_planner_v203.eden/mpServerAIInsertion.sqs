? alive red12 && local red12 : unassignVehicle red12
? alive red12 && local red12 : red12 setPos [lzX + 12, lzY + -3, 0]
goto "mpDone"
#mpWaitDismount
@ mpDismountNow
? insertionPara : goto "mpParadropStick"
? alive red2 && local red2 : red2 action ["GETOUT", vehicle red2]
? alive red2 && local red2 : unassignVehicle red2
? alive red3 && local red3 : red3 action ["GETOUT", vehicle red3]
? alive red3 && local red3 : unassignVehicle red3
? alive medic1 && local medic1 : medic1 action ["GETOUT", vehicle medic1]
? alive medic1 && local medic1 : unassignVehicle medic1
? alive medic2 && local medic2 : medic2 action ["GETOUT", vehicle medic2]
? alive medic2 && local medic2 : unassignVehicle medic2
? alive red6 && local red6 : red6 action ["GETOUT", vehicle red6]
? alive red6 && local red6 : unassignVehicle red6
? alive red7 && local red7 : red7 action ["GETOUT", vehicle red7]
? alive red7 && local red7 : unassignVehicle red7
? alive red8 && local red8 : red8 action ["GETOUT", vehicle red8]
? alive red8 && local red8 : unassignVehicle red8
? alive red9 && local red9 : red9 action ["GETOUT", vehicle red9]
? alive red9 && local red9 : unassignVehicle red9
? alive red10 && local red10 : red10 action ["GETOUT", vehicle red10]
? alive red10 && local red10 : unassignVehicle red10
? alive red11 && local red11 : red11 action ["GETOUT", vehicle red11]
? alive red11 && local red11 : unassignVehicle red11
? alive red12 && local red12 : red12 action ["GETOUT", vehicle red12]
? alive red12 && local red12 : unassignVehicle red12
goto "mpGroundDismountDone"
#mpParadropStick
? alive red2 && local red2 : red2 action ["EJECT", vehicle red2]
? alive red2 && local red2 : unassignVehicle red2
~0.25
? alive red3 && local red3 : red3 action ["EJECT", vehicle red3]
? alive red3 && local red3 : unassignVehicle red3
~0.25
? alive medic1 && local medic1 : medic1 action ["EJECT", vehicle medic1]
? alive medic1 && local medic1 : unassignVehicle medic1
~0.25
? alive medic2 && local medic2 : medic2 action ["EJECT", vehicle medic2]
? alive medic2 && local medic2 : unassignVehicle medic2
~0.25
? alive red6 && local red6 : red6 action ["EJECT", vehicle red6]
? alive red6 && local red6 : unassignVehicle red6
~0.25
? alive red7 && local red7 : red7 action ["EJECT", vehicle red7]
? alive red7 && local red7 : unassignVehicle red7
~0.25
? alive red8 && local red8 : red8 action ["EJECT", vehicle red8]
? alive red8 && local red8 : unassignVehicle red8
~0.25
? alive red9 && local red9 : red9 action ["EJECT", vehicle red9]
? alive red9 && local red9 : unassignVehicle red9
~0.25
? alive red10 && local red10 : red10 action ["EJECT", vehicle red10]
? alive red10 && local red10 : unassignVehicle red10
~0.25
? alive red11 && local red11 : red11 action ["EJECT", vehicle red11]
? alive red11 && local red11 : unassignVehicle red11
~0.25
? alive red12 && local red12 : red12 action ["EJECT", vehicle red12]
? alive red12 && local red12 : unassignVehicle red12
~0.25
goto "mpDone"
#mpGroundDismountDone
~8
? alive red2 && local red2 && vehicle red2 != red2 : red2 setPos [lzX + -12, lzY + -10, 0]
? alive red3 && local red3 && vehicle red3 != red3 : red3 setPos [lzX + -6, lzY + -10, 0]
? alive medic1 && local medic1 && vehicle medic1 != medic1 : medic1 setPos [lzX + 0, lzY + -10, 0]
? alive medic2 && local medic2 && vehicle medic2 != medic2 : medic2 setPos [lzX + 6, lzY + -10, 0]
? alive red6 && local red6 && vehicle red6 != red6 : red6 setPos [lzX + 12, lzY + -10, 0]
? alive red7 && local red7 && vehicle red7 != red7 : red7 setPos [lzX + -18, lzY + -3, 0]
? alive red8 && local red8 && vehicle red8 != red8 : red8 setPos [lzX + -12, lzY + -3, 0]
? alive red9 && local red9 && vehicle red9 != red9 : red9 setPos [lzX + -6, lzY + -3, 0]
