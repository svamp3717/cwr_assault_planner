? alive red12 && local red12 : red12 moveInCargo apcP2
goto "mpWaitDismount"
#mpDirectParadrop
? alive red2 && local red2 : [red2, lzX + -12, lzY + -12, 170, 53] exec "friendlyDirectParachute.sqs"
? alive red3 && local red3 : [red3, lzX + -6, lzY + -12, 172, 53] exec "friendlyDirectParachute.sqs"
? alive medic1 && local medic1 : [medic1, lzX + 0, lzY + -12, 174, 53] exec "friendlyDirectParachute.sqs"
? alive medic2 && local medic2 : [medic2, lzX + 6, lzY + -12, 176, 53] exec "friendlyDirectParachute.sqs"
? alive red6 && local red6 : [red6, lzX + 12, lzY + -12, 178, 53] exec "friendlyDirectParachute.sqs"
? alive red7 && local red7 : [red7, lzX + -18, lzY + -4, 170, 53] exec "friendlyDirectParachute.sqs"
? alive red8 && local red8 : [red8, lzX + -12, lzY + -4, 172, 53] exec "friendlyDirectParachute.sqs"
? alive red9 && local red9 : [red9, lzX + -6, lzY + -4, 174, 53] exec "friendlyDirectParachute.sqs"
? alive red10 && local red10 : [red10, lzX + 0, lzY + -4, 176, 53] exec "friendlyDirectParachute.sqs"
? alive red11 && local red11 : [red11, lzX + 6, lzY + -4, 178, 53] exec "friendlyDirectParachute.sqs"
? alive red12 && local red12 : [red12, lzX + 12, lzY + -4, 180, 53] exec "friendlyDirectParachute.sqs"
goto "mpDone"
