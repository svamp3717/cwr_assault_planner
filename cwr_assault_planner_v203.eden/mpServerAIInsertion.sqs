? alive red10 && local red10 : red10 moveInCargo truckP2
? alive red11 && local red11 : red11 assignAsCargo truckP2
? alive red11 && local red11 : red11 moveInCargo truckP2
? alive red12 && local red12 : red12 assignAsCargo truckP2
? alive red12 && local red12 : red12 moveInCargo truckP2
goto "mpWaitDismount"
#mpAPC
