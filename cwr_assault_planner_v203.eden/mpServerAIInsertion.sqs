? alive red11 && local red11 : red11 moveInCargo apcP2
? alive red12 && local red12 : red12 assignAsCargo apcP2
? alive red12 && local red12 : red12 moveInCargo apcP2
goto "mpWaitDismount"
#mpMixed
? alive red2 && local red2 : red2 assignAsCargo apcP1
? alive red2 && local red2 : red2 moveInCargo apcP1
? alive red3 && local red3 : red3 assignAsCargo apcP1
? alive red3 && local red3 : red3 moveInCargo apcP1
