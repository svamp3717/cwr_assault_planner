; MP v104 server-local AI insertion.
; Mirrors player insertion for subordinate AI owned by the server.
; Human players are moved by their own client scripts.
~0.5
? insertionFoot : goto "mpFoot"
? insertionTruck : goto "mpTruck"
? insertionAPC : goto "mpAPC"
? insertionPara : goto "mpDirectParadrop"
? insertionHeli : goto "mpHeli"
goto "mpDone"
#mpTruck
? alive red2 && local red2 : red2 assignAsCargo truckP1
? alive red2 && local red2 : red2 moveInCargo truckP1
? alive red3 && local red3 : red3 assignAsCargo truckP1
? alive red3 && local red3 : red3 moveInCargo truckP1
? alive medic1 && local medic1 : medic1 assignAsCargo truckP1
? alive medic1 && local medic1 : medic1 moveInCargo truckP1
? alive medic2 && local medic2 : medic2 assignAsCargo truckP1
? alive medic2 && local medic2 : medic2 moveInCargo truckP1
? alive red6 && local red6 : red6 assignAsCargo truckP1
? alive red6 && local red6 : red6 moveInCargo truckP1
? alive red7 && local red7 : red7 assignAsCargo truckP2
? alive red7 && local red7 : red7 moveInCargo truckP2
? alive red8 && local red8 : red8 assignAsCargo truckP2
? alive red8 && local red8 : red8 moveInCargo truckP2
? alive red9 && local red9 : red9 assignAsCargo truckP2
? alive red9 && local red9 : red9 moveInCargo truckP2
