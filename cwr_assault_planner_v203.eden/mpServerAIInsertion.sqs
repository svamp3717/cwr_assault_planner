? alive red12 && local red12 : red12 moveInCargo heliP1
goto "mpWaitDismount"
#mpHeliSplit
? alive red2 && local red2 : red2 assignAsCargo heliU1
? alive red2 && local red2 : red2 moveInCargo heliU1
? alive red3 && local red3 : red3 assignAsCargo heliU1
? alive red3 && local red3 : red3 moveInCargo heliU1
? alive medic1 && local medic1 : medic1 assignAsCargo heliU1
? alive medic1 && local medic1 : medic1 moveInCargo heliU1
? alive medic2 && local medic2 : medic2 assignAsCargo heliU1
? alive medic2 && local medic2 : medic2 moveInCargo heliU1
? alive red6 && local red6 : red6 assignAsCargo heliU1
? alive red6 && local red6 : red6 moveInCargo heliU1
? alive red7 && local red7 : red7 assignAsCargo heliU2
? alive red7 && local red7 : red7 moveInCargo heliU2
