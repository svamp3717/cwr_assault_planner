? alive red9 && local red9 : red9 moveInCargo heliU2
? alive red10 && local red10 : red10 assignAsCargo heliU2
? alive red10 && local red10 : red10 moveInCargo heliU2
? alive red11 && local red11 : red11 assignAsCargo heliU2
? alive red11 && local red11 : red11 moveInCargo heliU2
? alive red12 && local red12 : red12 assignAsCargo heliU2
? alive red12 && local red12 : red12 moveInCargo heliU2
goto "mpWaitDismount"
#mpFoot
? alive red2 && local red2 : unassignVehicle red2
? alive red2 && local red2 : red2 setPos [lzX + -12, lzY + -10, 0]
? alive red3 && local red3 : unassignVehicle red3
? alive red3 && local red3 : red3 setPos [lzX + -6, lzY + -10, 0]
? alive medic1 && local medic1 : unassignVehicle medic1
? alive medic1 && local medic1 : medic1 setPos [lzX + 0, lzY + -10, 0]
? alive medic2 && local medic2 : unassignVehicle medic2
? alive medic2 && local medic2 : medic2 setPos [lzX + 6, lzY + -10, 0]
? alive red6 && local red6 : unassignVehicle red6
? alive red6 && local red6 : red6 setPos [lzX + 12, lzY + -10, 0]
? alive red7 && local red7 : unassignVehicle red7
? alive red7 && local red7 : red7 setPos [lzX + -18, lzY + -3, 0]
? alive red8 && local red8 : unassignVehicle red8
? alive red8 && local red8 : red8 setPos [lzX + -12, lzY + -3, 0]
? alive red9 && local red9 : unassignVehicle red9
? alive red9 && local red9 : red9 setPos [lzX + -6, lzY + -3, 0]
? alive red10 && local red10 : unassignVehicle red10
