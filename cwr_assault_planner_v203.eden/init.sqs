; Server owns randomization, enemy AI, vehicles, support and objective progression.
? isServer : [] exec "mpServerMain.sqs"

; This bootstrap waits for a local player, so it is harmless on a dedicated server.
[] exec "mpClientMain.sqs"

; Starts on clients and dedicated/listen server after the active playable roster is known.
[] exec "mpFReviveBootstrap.sqs"

exit
