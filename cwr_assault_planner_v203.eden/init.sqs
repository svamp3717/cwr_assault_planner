; Thin bootstrap for world portability.
; The historical bootstrap lives in init_core.sqs unchanged. Once it has initialized its legacy defaults,
; worldConfig.sqs replaces the world-specific location catalogue and, when requested, creates hidden site markers.
missionWin = true
[] exec "init_core.sqs"
@ !(missionWin)
worldConfigReady = false
[] exec "worldConfig.sqs"
@ worldConfigReady
exit
