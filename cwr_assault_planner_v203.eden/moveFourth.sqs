; Move friendly forces to Objective 4.
? alliedCount < 1 : goto "afterA1"
a1ldr doMove [fourthX, fourthY, 0]
#afterA1
? alliedCount < 2 : goto "afterA2"
a2ldr doMove [fourthX, fourthY, 0]
#afterA2
? alliedCount < 3 : goto "afterA3"
a3ldr doMove [fourthX, fourthY, 0]
#afterA3
? alliedCount < 4 : goto "afterA4"
a4ldr doMove [fourthX, fourthY, 0]
#afterA4
? supportGround : [] exec "sendGroundSupportFourth.sqs"
exit
