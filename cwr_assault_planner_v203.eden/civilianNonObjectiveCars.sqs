; Custom patch: remembered proximity-streamed civilian-car profiles.
; Every imported location independently rolls a 25 percent chance.
; Active objective locations are still skipped by civilianNonObjectiveCarProfile.sqs.
civilianNonObjectiveCarsReady = false
civilianNonObjectiveCarProfileCount = 0
civilianNamedCarProfileCount = 0
civilianUnnamedCarProfileCount = 0
_i = 0
#namedProfileLoop
? _i >= missionTrafficTotal : goto "unnamedProfiles"
_roll = random 4
? _roll >= 1 : goto "namedNext"
_beforeCount = civilianNonObjectiveCarProfileCount
_x = missionTrafficXs select _i
_y = missionTrafficYs select _i
? worldUseEditorLocationMarkers : _marker = missionTrafficMarkers select _i
? worldUseEditorLocationMarkers : _pos = getMarkerPos _marker
? worldUseEditorLocationMarkers : _x = _pos select 0
? worldUseEditorLocationMarkers : _y = _pos select 1
civilianNonObjectiveCarProfileReady = false
[_x, _y, missionTrafficLabels select _i] exec "civilianNonObjectiveCarProfile.sqs"
@ civilianNonObjectiveCarProfileReady
? civilianNonObjectiveCarProfileCount > _beforeCount : civilianNamedCarProfileCount = civilianNamedCarProfileCount + 1
#namedNext
_i = _i + 1
goto "namedProfileLoop"

#unnamedProfiles
; Legacy unnamed traffic locations remain supported if a world config supplies them.
_i = 0
#unnamedProfileLoop
? _i >= missionUnnamedTrafficTotal : goto "profilesDone"
_roll = random 4
? _roll >= 1 : goto "unnamedNext"
_beforeCount = civilianNonObjectiveCarProfileCount
_x = missionUnnamedTrafficXs select _i
_y = missionUnnamedTrafficYs select _i
? worldUseEditorLocationMarkers : _marker = missionUnnamedTrafficMarkers select _i
? worldUseEditorLocationMarkers : _pos = getMarkerPos _marker
? worldUseEditorLocationMarkers : _x = _pos select 0
? worldUseEditorLocationMarkers : _y = _pos select 1
civilianNonObjectiveCarProfileReady = false
[_x, _y, missionUnnamedTrafficLabels select _i] exec "civilianNonObjectiveCarProfile.sqs"
@ civilianNonObjectiveCarProfileReady
? civilianNonObjectiveCarProfileCount > _beforeCount : civilianUnnamedCarProfileCount = civilianUnnamedCarProfileCount + 1
#unnamedNext
_i = _i + 1
goto "unnamedProfileLoop"

#profilesDone
? debugMode : debugLog format ["ERA DEBUG CIVSTREAM PROFILES: imported25pct=%1 legacyUnnamed25pct=%2 total=%3", civilianNamedCarProfileCount, civilianUnnamedCarProfileCount, civilianNonObjectiveCarProfileCount]
civilianNonObjectiveCarsReady = true
exit
