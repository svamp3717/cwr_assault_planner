; v164 CWA-safe short-range stop command for a downed pilot.
_pilot = _this select 0
_caller = _this select 1
? isNull _pilot : exit
? !(alive _pilot) : exit
? isNull _caller : exit
_pp = getPos _pilot
_cp = getPos _caller
_dx = (_pp select 0) - (_cp select 0)
_dy = (_pp select 1) - (_cp select 1)
? ((_dx * _dx) + (_dy * _dy)) > 25 : goto "tooFar"
pilotCommandUnit = _pilot
pilotCommandCaller = _caller
pilotCommandType = 2
pilotCommandRequestStamp = time + random 100000
publicVariable "pilotCommandUnit"
publicVariable "pilotCommandCaller"
publicVariable "pilotCommandType"
publicVariable "pilotCommandRequestStamp"
titleText ["Downed pilot ordered to stop.","PLAIN DOWN"]
exit
#tooFar
titleText ["Move closer to the downed pilot.","PLAIN DOWN"]
exit
