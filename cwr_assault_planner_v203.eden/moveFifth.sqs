; Move friendly forces to Objective 5.
? alliedCount < 1 : goto "afterA1"
a1ldr doMove [fifthX, fifthY, 0]
#afterA1
? alliedCount < 2 : goto "afterA2"
a2ldr doMove [fifthX, fifthY, 0]
#afterA2
? alliedCount < 3 : goto "afterA3"
a3ldr doMove [fifthX, fifthY, 0]
#afterA3
? alliedCount < 4 : goto "afterA4"
a4ldr doMove [fifthX, fifthY, 0]
#afterA4
? supportGround : [] exec "sendGroundSupportFifth.sqs"
exit
