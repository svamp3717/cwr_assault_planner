; WW4 faction randomizer for Everon Random Assault WW4.
; v129: class-only faction selection; runtime scripts create selected units as needed.
; Selects one non-desert EAST category and one non-desert Resistance category each startup.
; No editor air or reinforcement placeholders are required.
; Desert-prefixed classes (WW4_D*) are intentionally not used.
ww4FactionReady = false
ww4EastCategoryLabel = "East Army"
ww4ResCategoryLabel = "Everon Alliance"
; Pick East non-desert WW4 faction category.
_r = random 11
? _r < 1 : goto "eastCat0"
? _r < 2 : goto "eastCat1"
? _r < 3 : goto "eastCat2"
? _r < 4 : goto "eastCat3"
? _r < 5 : goto "eastCat4"
? _r < 6 : goto "eastCat5"
? _r < 7 : goto "eastCat6"
? _r < 8 : goto "eastCat7"
? _r < 9 : goto "eastCat8"
? _r < 10 : goto "eastCat9"
goto "eastCat10"
#eastCat0
ww4EastCategoryLabel = "East Army"
ww4EastRifleman = "WW4_MOTRifleman"
ww4EastGrenadier = "WW4_MOTGrenadier"
ww4EastMedic = "WW4_MOTMedic"
