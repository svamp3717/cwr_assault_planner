? alive s5Rveh3 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doTarget s5Rveh3
? alive s5Rveh3 && alive (driver supportAirVehicle) : driver supportAirVehicle doTarget s5Rveh3
? alive s5Rveh3 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doFire s5Rveh3
? alive s5Rveh3 && alive (driver supportAirVehicle) : driver supportAirVehicle doFire s5Rveh3
? alive s5Rveh5 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doTarget s5Rveh5
? alive s5Rveh5 && alive (driver supportAirVehicle) : driver supportAirVehicle doTarget s5Rveh5
? alive s5Rveh5 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doFire s5Rveh5
? alive s5Rveh5 && alive (driver supportAirVehicle) : driver supportAirVehicle doFire s5Rveh5
? alive w4s5R6 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doTarget w4s5R6
? alive w4s5R6 && alive (driver supportAirVehicle) : driver supportAirVehicle doTarget w4s5R6
? alive w4s5R6 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doFire w4s5R6
? alive w4s5R6 && alive (driver supportAirVehicle) : driver supportAirVehicle doFire w4s5R6
? alive w4s5R8 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doTarget w4s5R8
? alive w4s5R8 && alive (driver supportAirVehicle) : driver supportAirVehicle doTarget w4s5R8
? alive w4s5R8 && alive (gunner supportAirVehicle) : gunner supportAirVehicle doFire w4s5R8
? alive w4s5R8 && alive (driver supportAirVehicle) : driver supportAirVehicle doFire w4s5R8
goto "airPatrol"
#airPatrol
~20
? missionEnded : exit
supportAirVehicle doMove [airTargetX + 350, airTargetY, 0]
supportAirVehicle action ["ENGINEON", supportAirVehicle]
~25
? missionEnded : exit
supportAirVehicle doMove [airTargetX - 350, airTargetY, 0]
supportAirVehicle action ["ENGINEON", supportAirVehicle]
~25
? missionEnded : exit
supportAirVehicle doMove [airTargetX, airTargetY + 350, 0]
supportAirVehicle action ["ENGINEON", supportAirVehicle]
~25
? missionEnded : exit
supportAirVehicle doMove [airTargetX, airTargetY - 350, 0]
exit
