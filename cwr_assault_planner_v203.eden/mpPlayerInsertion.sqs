#mpDirectParadrop
_paraX = lzX
_paraY = lzY
_paraZ = 170
? player == plr : _paraX = lzX - 18
? player == plr : _paraY = lzY - 12
? player == red2 : _paraX = lzX - 12
? player == red2 : _paraY = lzY - 12
? player == red3 : _paraX = lzX - 6
? player == red3 : _paraY = lzY - 12
? player == medic1 : _paraX = lzX
? player == medic1 : _paraY = lzY - 12
? player == medic2 : _paraX = lzX + 6
? player == medic2 : _paraY = lzY - 12
? player == red6 : _paraX = lzX + 12
? player == red6 : _paraY = lzY - 12
? player == red7 : _paraX = lzX - 18
? player == red7 : _paraY = lzY - 4
? player == red8 : _paraX = lzX - 12
? player == red8 : _paraY = lzY - 4
? player == red9 : _paraX = lzX - 6
? player == red9 : _paraY = lzY - 4
? player == red10 : _paraX = lzX
? player == red10 : _paraY = lzY - 4
? player == red11 : _paraX = lzX + 6
? player == red11 : _paraY = lzY - 4
? player == red12 : _paraX = lzX + 12
? player == red12 : _paraY = lzY - 4
[player, _paraX, _paraY, _paraZ, 53] exec "friendlyDirectParachute.sqs"
goto "mpDone"
