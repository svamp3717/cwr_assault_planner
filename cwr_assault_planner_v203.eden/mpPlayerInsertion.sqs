#mpFoot
? alive plr && local plr : unassignVehicle plr
? alive plr && local plr : plr setPos [lzX + -18, lzY + -10, 0]
? alive red2 && local red2 : unassignVehicle red2
? alive red2 && local red2 : red2 setPos [lzX + -12, lzY + -10, 0]
? alive red3 && local red3 : unassignVehicle red3
? alive red3 && local red3 : red3 setPos [lzX + -6, lzY + -10, 0]
? alive medic1 && local medic1 : unassignVehicle medic1
? alive medic1 && local medic1 : medic1 setPos [lzX + 0, lzY + -10, 0]
? alive medic2 && local medic2 : unassignVehicle medic2
? alive medic2 && local medic2 : medic2 setPos [lzX + 6, lzY + -10, 0]
