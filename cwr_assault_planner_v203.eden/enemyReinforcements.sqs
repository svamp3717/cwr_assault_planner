? alive w4rAirR12 : unassignVehicle w4rAirR12
? alive w4rAirR1 : w4rAirR1 setPos [reinfGroundDstX - 14, reinfGroundDstY - 10, 0]
? alive w4rAirR2 : w4rAirR2 setPos [reinfGroundDstX - 8, reinfGroundDstY - 8, 0]
? alive w4rAirR3 : w4rAirR3 setPos [reinfGroundDstX - 2, reinfGroundDstY - 6, 0]
? alive w4rAirR4 : w4rAirR4 setPos [reinfGroundDstX + 4, reinfGroundDstY - 4, 0]
? alive w4rAirR5 : w4rAirR5 setPos [reinfGroundDstX + 10, reinfGroundDstY - 2, 0]
