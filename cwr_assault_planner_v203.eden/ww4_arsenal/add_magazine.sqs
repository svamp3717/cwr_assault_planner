; Add one selected compatible item to the active arsenal target.

_target = WW4_ArsenalTarget
? isNull _target : hint "Arsenal target unavailable."; exit
? !(alive _target) : hint "Arsenal target is not alive."; exit
? _target == player : goto "TargetValid"
? group _target == group player : goto "TargetValid"
hint "The selected unit is no longer in your squad."
exit

#TargetValid
_mi = lbCurSel 1502
? _mi >= 0 : goto "HaveMagazine"
hint "Select a compatible magazine or item first."
exit

#HaveMagazine
_mag = lbData [1502,_mi]
? _mag == assetClassHandGrenade : _target addWeapon assetClassThrow
? _mag == assetClassSmokeShell : _target addWeapon assetClassThrow
? _mag == assetClassSmokeShellGreen : _target addWeapon assetClassThrow
? _mag == assetClassSmokeShellRed : _target addWeapon assetClassThrow
? _mag == assetClassPipeBomb : _target addWeapon assetClassPut
? _mag == assetClassTimeBomb : _target addWeapon assetClassPut
? _mag == assetClassMine : _target addWeapon assetClassPut
? _mag == assetClassMineE : _target addWeapon assetClassPut
_target addMagazine _mag
hint format ["Added to %1: %2",name _target,_mag]
exit
