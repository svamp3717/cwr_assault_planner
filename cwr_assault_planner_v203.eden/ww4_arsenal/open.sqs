; Open and populate the three-column arsenal.
; The addAction caller (_this select 1) becomes the equipment target.
; Internal reopen calls pass an empty array and preserve the current target.

@WW4_ArsenalDataReady
@WW4_PlayerModelDataReady

? count _this < 2 : goto "UseExistingTarget"
_candidate = _this select 1
? isNull _candidate : goto "UseExistingTarget"
WW4_ArsenalTarget = _candidate

#UseExistingTarget
? isNull WW4_ArsenalTarget : WW4_ArsenalTarget = player
? !(alive WW4_ArsenalTarget) : hint "WW4 Arsenal: the selected unit is not alive."; exit
? WW4_ArsenalTarget == player : goto "TargetAccepted"
? group WW4_ArsenalTarget == group player : goto "TargetAccepted"
hint "WW4 Arsenal: only you or a member of your current squad can be equipped."
WW4_ArsenalTarget = player
exit

#TargetAccepted
_ok = createDialog "WW4_Arsenal_Dialog"
? _ok : goto "DialogOpened"
hint "WW4 Arsenal: dialog could not be opened. Check description.ext."
exit

#DialogOpened
@dialog
ctrlSetText [1000,format ["WW4 ARSENAL - %1",name WW4_ArsenalTarget]]
ctrlSetText [1002,format ["Target: %1. Select a family and variant.",name WW4_ArsenalTarget]]
lbClear 1500
lbClear 1501
lbClear 1502

_i = 0
#FamilyLoop
? _i >= count WW4_ArsenalFamilies : goto "FamilyDone"
_family = WW4_ArsenalFamilies select _i
_row = lbAdd [1500,_family select 0]
_i = _i + 1
goto "FamilyLoop"

#FamilyDone
? count WW4_ArsenalFamilies == 0 : hint "WW4 Arsenal: no equipment families loaded."; exit
WW4_ArsenalLastFamily = -1
WW4_ArsenalLastVariant = -1
WW4_ArsenalLastAmmo = -1
lbSetCurSel [1500,0]
[] exec "ww4_arsenal\selection_watch.sqs"
exit
