; Replace combat gear on the active target, or add utility equipment without clearing gear.

_target = WW4_ArsenalTarget
? isNull _target : hint "Arsenal target unavailable."; exit
? !(alive _target) : hint "Arsenal target is not alive."; exit
? _target == player : goto "TargetValid"
? group _target == group player : goto "TargetValid"
hint "The selected unit is no longer in your squad."
exit

#TargetValid
_vi = lbCurSel 1501
? _vi >= 0 : goto "HaveWeapon"
hint "Select a weapon or equipment item first."
exit

#HaveWeapon
_weapon = lbData [1501,_vi]
? _weapon == "Binocular" : goto "ApplyUtility"
? _weapon == "NVGoggles" : goto "ApplyUtility"
? _weapon == "LaserDesignator" : goto "ApplyUtility"
? _weapon == "WW4EXT_SOFLAM" : goto "ApplyUtility"
? _weapon == "ww4_radio" : goto "ApplyUtility"
? _weapon == "MAP_Rucksack" : goto "ApplyUtility"
? _weapon == "Throw" : goto "ApplyThrowable"
? _weapon == "Put" : goto "ApplySatchel"
_mag = ""
_mi = lbCurSel 1502
? _mi < 0 : goto "ClearGear"
_mag = lbData [1502,_mi]

#ClearGear
removeAllWeapons _target
? _mag == "" : goto "AddWeapon"
_i = 0

#AmmoLoop
? _i >= WW4_ArsenalDefaultMags : goto "AddWeapon"
_target addMagazine _mag
_i = _i + 1
goto "AmmoLoop"

#AddWeapon
_target addWeapon _weapon
_target selectWeapon _weapon
hint format ["Applied to %1: %2 with up to %3 selected magazines/items.",name _target,_weapon,WW4_ArsenalDefaultMags]
exit

#ApplyThrowable
_mi = lbCurSel 1502
? _mi >= 0 : goto "HaveThrowable"
hint "Select a grenade first."
exit

#HaveThrowable
_mag = lbData [1502,_mi]
_target addWeapon "Throw"
_target addMagazine _mag
hint format ["Added grenade to %1 without clearing gear: %2",name _target,_mag]
exit

#ApplySatchel
_mi = lbCurSel 1502
? _mi >= 0 : goto "HaveSatchel"
hint "Select an explosive or mine first."
exit

#HaveSatchel
_mag = lbData [1502,_mi]
_target addWeapon "Put"
_target addMagazine _mag
hint format ["Added explosive or mine to %1 without clearing gear: %2",name _target,_mag]
exit

#ApplyUtility
? _weapon == "LaserDesignator" : _target addMagazine "LaserDesignator"
? _weapon == "ww4_radio" : _target addMagazine "ww4_radiobat"
_target addWeapon _weapon
? _weapon in weapons _target : goto "UtilitySuccess"
hint format ["Could not add %1 to %2. Its equipment slot may already be occupied.",_weapon,name _target]
exit

#UtilitySuccess
hint format ["Added equipment to %1 without clearing gear: %2",name _target,_weapon]
exit
