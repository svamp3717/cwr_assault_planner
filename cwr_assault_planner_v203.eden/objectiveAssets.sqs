objectiveTypeLabel1 = "Recover Downed Pilot"
objectiveTaskText1 = format ["Locate the map-marked downed pilot near %1, order him to follow, and escort him to the marked safe settlement at %2. The pilot can ride in cargo vehicles.", townLabel, objectivePilotDestinationLabel1]
goto "objective1Finished"
