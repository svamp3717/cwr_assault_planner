? townCount >= 5 && objectiveType5 != 0 : _allClearTasks = false
? guiObjectiveTypesRandom && townCount >= 2 && _allClearTasks : objectiveType1 = 4
; Objective 1.
? townCount < 1 : goto "objective1Finished"
? objectiveType1 == 1 : goto "objective1Destroy"
? objectiveType1 == 2 : goto "objective1Intel"
? objectiveType1 == 3 : goto "objective1AmmoBox"
? objectiveType1 == 4 : goto "objective1Communications"
? objectiveType1 == 5 : goto "objective1Mortar"
? objectiveType1 == 6 : goto "objective1Fuel"
? objectiveType1 == 7 : goto "objective1Rescue"
? objectiveType1 == 8 : goto "objective1Steal"
? objectiveType1 == 9 : goto "objective1Pilot"
objectiveTypeLabel1 = "Clear Area"
objectiveTaskText1 = format ["Clear hostile forces from the area around %1.", townLabel]
goto "objective1Finished"
#objective1Destroy
_targetRoll = random 3
? _targetRoll < 1 : goto "objective1Scud"
? _targetRoll < 2 : goto "objective1Ammo"
goto "objective1Shilka"
#objective1Scud
_targetClass = "Scud"
objectiveTargetLabel1 = "SCUD launcher"
goto "objective1CreateDestroy"
#objective1Ammo
? enemyEast : _targetClass = "WW4EXT_UralAmmo"
? enemyResistance : _targetClass = "WW4EXT_PV3SAR"
objectiveTargetLabel1 = "ammunition truck"
goto "objective1CreateDestroy"
#objective1Shilka
? enemyEast : _targetClass = "WW4EXT_ZSU"
? enemyResistance : _targetClass = "WW4EXT_ZSUR"
objectiveTargetLabel1 = "Shilka AA vehicle"
#objective1CreateDestroy
objectiveTarget1 = _targetClass createVehicle [primaryX + 85, primaryY + -45, 0]
objectiveTarget1 setDir 235
objectiveTarget1 setFuel 0
objectiveTarget1 lock true
objectiveTarget1 setDammage 0
objectiveTypeLabel1 = format ["Destroy %1", objectiveTargetLabel1]
objectiveTaskText1 = format ["Destroy the %1 near %2.", objectiveTargetLabel1, townLabel]
goto "objective1Finished"
#objective1Intel
objectiveTarget1 = "TableMap" createVehicle [primaryX + 42, primaryY + -23, 0]
objectiveTarget1 setDir 235
objectiveTarget1 allowDammage false
objectiveTargetLabel1 = "intelligence file"
objectiveTypeLabel1 = "Collect Intel"
objectiveTaskText1 = format ["Collect the intelligence file near %1.", townLabel]
goto "objective1Finished"
#objective1AmmoBox
objectiveTarget1 = objectiveTownAmmoBox1
objectiveTargetLabel1 = "enemy ammunition box"
objectiveTypeLabel1 = "Destroy Ammo Box"
objectiveTaskText1 = format ["Destroy the enemy ammunition box near %1.", townLabel]
goto "objective1Finished"
#objective1Communications
[1,4,primaryX + 85,primaryY + -45,235,townLabel] exec "objectiveSpecialSite.sqs"
@ objectiveSpecialSiteReady1
objectiveTargetLabel1 = "communications site"
objectiveTypeLabel1 = "Destroy Communications"
objectiveTaskText1 = format ["Destroy the enemy radio tower or its control equipment near %1.", townLabel]
goto "objective1Finished"
#objective1Mortar
[1,5,primaryX + 85,primaryY + -45,235,townLabel] exec "objectiveSpecialSite.sqs"
@ objectiveSpecialSiteReady1
objectiveTargetLabel1 = "static artillery position"
objectiveTypeLabel1 = "Neutralize Artillery Position"
objectiveTaskText1 = format ["Destroy the static artillery piece, destroy its ammunition cache, or eliminate both operators near %1.", townLabel]
goto "objective1Finished"
#objective1Fuel
[1,6,primaryX + 85,primaryY + -45,235,townLabel] exec "objectiveSpecialSite.sqs"
@ objectiveSpecialSiteReady1
objectiveTargetLabel1 = "fuel depot"
objectiveTypeLabel1 = "Destroy Fuel Depot"
objectiveTaskText1 = format ["Destroy the military fuel station or its refuelling vehicle near %1.", townLabel]
goto "objective1Finished"
#objective1Rescue
civilianRescueDestinationReady = false
[1,primaryX,primaryY,townLabel] exec "civilianRescueDestination.sqs"
@ civilianRescueDestinationReady
objectiveTargetLabel1 = "town civilians"
objectiveTypeLabel1 = "Save Civilians"
objectiveTaskText1 = format ["Escort at least three civilians from %1 to the marked safe town at %2. All rescue civilians are marked on the map. Use Follow Me and Stop actions; civilians can ride in cargo vehicles.", townLabel, objectiveRescueDestinationLabel1]
goto "objective1Finished"
#objective1Steal
stealVehicleSiteReady = false
[1,primaryX + 110,primaryY + 55,180,primaryX,primaryY,townLabel] exec "stealVehicleObjective.sqs"
@ stealVehicleSiteReady
objectiveTargetLabel1 = objectiveStealVehicleLabel1
objectiveTypeLabel1 = "Steal a Vehicle"
objectiveTaskText1 = format ["Capture the %1 near %2 and deliver it to the marked recovery town at %3.", objectiveStealVehicleLabel1, townLabel, objectiveStealDestinationLabel1]
goto "objective1Finished"
#objective1Pilot
downedPilotObjectiveReady = false
[1,primaryX,primaryY,townLabel] exec "downedPilotObjective.sqs"
