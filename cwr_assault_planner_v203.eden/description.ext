onLoadMission="assault_planner_v203";
onLoadIntro="12-player cooperative Everon assault. Complete the selected objectives and extract the active squad by Chinook. Radio Bravo may call extraction early; Radio Charlie requests the configured number of logistics deliveries.";

// FRevive uses instant respawn, then suspends the replacement unit until a teammate revives it.
respawn = 2;
respawnDelay = 3;

class Header
{
    gameType = "COOP";
    minPlayers = 1;
    maxPlayers = 12;
};

class ERA_RscText
{
    type=0; idc=-1; style=0; x=0; y=0; w=0.1; h=0.04;
    font="TahomaB"; sizeEx=0.025;
    colorText[]={1,1,1,1}; colorBackground[]={0,0,0,0};
};
