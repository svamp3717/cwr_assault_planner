    colorBackground[]={0.12,0.16,0.20,1}; colorBackgroundActive[]={0.25,0.38,0.25,1}; colorFocused[]={0.25,0.38,0.25,1};
    soundEnter[]={"",0.1,1}; soundPush[]={"",0.1,1}; soundClick[]={"",0.1,1}; soundEscape[]={"",0.1,1}; default=0;
};

